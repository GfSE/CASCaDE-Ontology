cas-act:ConceptDefinition
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Concept definition"@en ,
		"Konzeptdefinition"@de
		;
	dcterms:modified "2022-02-18T11:17:54Z"^^xsd:dateTime ;
	skos:definition """In conceptual design, new products or systems are defined through requirements and specified through a functional structure in mechanical, electrics/electronics, and software domains. A logical structure specifies the future product architecture in order to implement the specified functions.
Besides new products, existing products may be changed or modified significantly to better comply with customer needs, or to attract new customers. Eventually, the product may be changed or adopted to comply to new standards, regulations or laws.
Conceptual design is usually performed at a high abstraction level and low level of detail, using parameter studies, system models, and rough geometry, if any.
For the Digital Data Package, model-based methods and data for product conceptual design are assumed."""@en ;
	.

cas-act:LongTermArchiving
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Langzeitarchivierung"@de ,
		"Long-Term Archiving"@en
		;
	cas:uses
		cas-proc:JoiningProcess ,
		cas-arch:Function ,
		cas-arch:StakeholderRequirement ,
		cas-arch:SystemRequirement ,
		cas-mech:Body ,
		cas-mech:JoiningElement ,
		cas-mech:KinematicJoint ,
		cas-mech:KinematicMechanism ,
		cas-mech:Material ,
		cas-mech:MechanicalComponent ,
		cas-mech:ModelAnnotation ,
		cas-sys:ComponentConnection ,
		cas-sys:ComponentInterface ,
		cas-sys:ComponentState ,
		cas-sys:Deviation ,
		cas-sys:SystemComponent ,
		cas-val:Displacement ,
		cas-val:ValidationResult ,
		cas-val:ValidationRun ,
		<http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationResult> ,
		<http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationRun>
		;
	skos:definition "For long-term archiving, all product information must be configured and stored in a retrievable way. Product information includes domain-specifc models, relations between models and model entities, and meta-data about the documents and models."@en ;
	.

cas-act:ManufacturingSupplyChain
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Manufacturing & Supply Chain"@en ,
		"Produktion & Lieferkette"@de
		;
	dcterms:modified "2021-11-24T10:35:16Z"^^xsd:dateTime ;
	skos:definition "Includes all activities related to source and manufacture a product in different companies, plants, or locations."@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ManufacturingSupplyChain/PackagingLogistics>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Packaging & Logistics"@en ,
		"Verpackung & Logistik"@de
		;
	cas:uses
		cas-proc:JoiningProcess ,
		cas-fld:HydraulicPneumaticConnection ,
		cas-fld:HydraulicPneumaticPort ,
		cas-mech:Body ,
		cas-mech:JoiningElement ,
		cas-mech:Material ,
		cas-mech:MechanicalComponent
		;
	skos:definition "Includes the definition of all kinds of packaging and transport equipment to ensure a product or its components will be supplied to their destination safely."@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ManufacturingSupplyChain/PartsManufacturing>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Parts Manufacturing"@en ,
		"Teilefertigung"@de
		;
	cas:uses
		cas-man:ManufacturingEquipmentComponent ,
		cas-proc:ManufacturingOperation ,
		cas-mech:BendingSpecification ,
		cas-mech:Body ,
		cas-mech:Cleanliness ,
		cas-mech:Datum ,
		cas-mech:DimensionalSize ,
		cas-mech:Gearing ,
		cas-mech:GeometricTolerance ,
		cas-mech:HeatTreatedArea ,
		cas-mech:Hole ,
		cas-mech:MarkingLabeling ,
		cas-mech:Material ,
		cas-mech:MechanicalComponent ,
		cas-mech:ModelView ,
		cas-mech:PaintedCoatedArea ,
		cas-mech:SurfaceTexture ,
		cas-mech:Thread
		;
	skos:definition "Manufacturing of single parts using a variety of production processes and methods, each with specific sets of data, such as CNC programs, bending specification, holes specifications, joining features, etc."@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ManufacturingSupplyChain/ProductAssembly>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Montage"@de ,
		"Product Assembly"@en
		;
	cas:uses
		cas-man:ManufacturingEquipmentComponent ,
		cas-proc:JoiningProcess ,
		cas-proc:ManufacturingOperation ,
		cas-mech:Body ,
		cas-mech:Datum ,
		cas-mech:DimensionalSize ,
		cas-mech:GeometricTolerance ,
		cas-mech:JoiningElement ,
		cas-mech:KinematicJoint ,
		cas-mech:KinematicMechanism ,
		cas-mech:Material ,
		cas-mech:MechanicalComponent ,
		cas-mech:ModelView ,
		cas-mech:SurfaceTexture
		;
	skos:definition "Assembly of components or products from single parts or sub-components according to a production plan, using all kinds of joinig and bonding."@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ManufacturingSupplyChain/QualityInspection>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Quality Inspection"@en ,
		"Qualitätskontrolle"@de
		;
	cas:uses
		cas-man:ControlPlan ,
		cas-proc:JoiningProcess ,
		cas-mech:Body ,
		cas-mech:JoiningElement ,
		cas-mech:MechanicalComponent ,
		<http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationCharacteristic> ,
		<http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationPlan> ,
		<http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationResource>
		;
	skos:definition "Includes the inspection of single parts, components or products during or after the manufacturing process, as well as the documentation of inspection results."@en ;
	.

cas-act:Procurement
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Beschaffung"@de ,
		"Procurement"@en
		;
	cas:uses
		cas-proc:JoiningProcess ,
		cas-ee:ElectricElectronicComponent ,
		cas-ee:ElectricElectronicConnection ,
		cas-ee:ElectricElectronicPort ,
		cas-mech:BendingSpecification ,
		cas-mech:Body ,
		cas-mech:Cleanliness ,
		cas-mech:Datum ,
		cas-mech:DimensionalSize ,
		cas-mech:Gearing ,
		cas-mech:GeometricTolerance ,
		cas-mech:HeatTreatedArea ,
		cas-mech:Hole ,
		cas-mech:JoiningElement ,
		cas-mech:MarkingLabeling ,
		cas-mech:Material ,
		cas-mech:MechanicalComponent ,
		cas-mech:PaintedCoatedArea ,
		cas-mech:SurfaceTexture ,
		cas-mech:Thread
		;
	skos:definition "Communication between procurement and suppliers in the bidding and iquiry phase. Supports the OMG Model-Based Aqcuisition initiative."@en ;
	.

cas-act:ProductDesign
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Product Design"@en ,
		"Produktentwurf"@de
		;
	dcterms:modified "2021-11-29T12:59:20Z"^^xsd:dateTime ;
	skos:definition """Product Design is the specific synthesis, implentation and documentation of design solutions suggested by systems engineering.
Product design comprises the domain-specific design processes of mechanical, electrical/electronical design, and software engineering."""@en ;
	.

cas-act:ProductDevelopment
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Product Development"@en ,
		"Produktentwicklung"@de
		;
	dcterms:modified "2022-02-18T11:15:52Z"^^xsd:dateTime ;
	skos:definition """Product development is the creation of products with new or modified characteristics that offer new or additional benefits to the customer, or comply with new or changed standards, rules and regulations.
Product development may involve modification of an existing product or its presentation or formulation of an entirely new product that satisfies a newly-defined or changed customer need or market segment.
Description based on: https://cio-wiki.org/wiki/Product_Development"""@en ;
	.

cas-con:AnalyzeDesignFailureModesAndEffectsDFmea
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Analyze design failure modes and effects (D-FMEA)"@en ,
		"Fehlermöglichkeiten und -einfluss analysieren (D-FMEA)"@de
		;
	skos:definition "Design Failure Modes and Effects Analysis (D-FMEA) is performed to systematically identify and evaluate potential failure modes in a product design before implementation. It assesses the impact, causes, and likelihood of failures, enabling teams to prioritize risks and define corrective actions early in the development process. This proactive approach improves product reliability, safety, and overall design quality while reducing development costs and rework."@en ;
	.

cas-con:AssessFunctionalSafety
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Assess functional safety"@en ,
		"Funktionale Sicherheit bewerten"@de
		;
	cas:provides
		cas-arch:Function ,
		cas-sys:ComponentConnection ,
		cas-sys:ComponentInterface ,
		cas-sys:ComponentState ,
		cas-sys:Deviation ,
		cas-sys:SystemComponent
		;
	cas:uses
		cas-org:Role ,
		cas-arch:Function ,
		cas-arch:SystemRequirement ,
		cas-arch:UseCase ,
		cas-sys:ComponentConnection ,
		cas-sys:ComponentInterface ,
		cas-sys:ComponentState ,
		cas-sys:SystemComponent
		;
	skos:definition "A Functional Safety Assessment (FSA) is conducted to independently evaluate whether a product, system, or process complies with applicable functional safety standards and safety requirements throughout its lifecycle. The assessment verifies the effectiveness of safety activities, identifies potential gaps, and provides evidence that safety objectives have been achieved before release or operation. It supports risk reduction and strengthens confidence in the safety integrity of the overall system."@en ;
	.

cas-con:BusinessOrMissionAnalysis
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Business or Mission Analysis"@en ,
		"Geschäfts- oder Einsatzanalyse"@de
		;
	cas:provides
		cas-org:Role ,
		cas-arch:UseCase
		;
	skos:definition """Product Planning is the ongoing process of identifying and articulating market requirements that define a product's feature set. Product planning serves as the basis for decisions about price, distribution and promotion.
Product planning is the process of creating a product idea and following through on it until the product is introduced to the market. Additionally, a small company must have an exit strategy for its product in case the product does not sell.
Product planning entails managing the product throughout its life using various marketing strategies, including product extensions or improvements, increased distribution, price changes and promotions.

Also includes the identification of relevant legal requirements as well as customs and tax regulations applicable to the product and the respective target markets.
Description based on: https://en.wikipedia.org/wiki/Product_planning"""@en ;
	.

cas-con:DefineSystemsArchitecture
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Define systems Architecture"@en ,
		"Systemarchitektur definieren"@de
		;
	cas:provides
		cas-arch:Function ,
		cas-sys:ComponentConnection ,
		cas-sys:ComponentInterface ,
		cas-sys:ComponentState ,
		cas-sys:Deviation ,
		cas-sys:SystemComponent
		;
	cas:uses
		cas-org:Role ,
		cas-arch:StakeholderRequirement ,
		cas-arch:UseCase
		;
	skos:definition "Systems architecture refers to the cross-domain definition of functions and logical structures at systems level, that will be pursued in detail by the individual domains mechanical design, electric/electronic design and software design."@en ;
	.

cas-con:RequirementsEngineering
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Anforderungsmanagement"@de ,
		"Requirements Engineering"@en
		;
	cas:provides cas-arch:Requirement ;
	cas:uses
		cas-org:Role ,
		cas-arch:UseCase
		;
	skos:definition """Requirements engineering is the process of defining, eliciting, documenting, and maintaining requirements in the engineering design process.
Description based on: https://en.wikipedia.org/wiki/Requirements_engineering"""@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ProductDesign/ElectricalElectronicalDesign>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Electrical/Electronical Design"@en ,
		"Elektrik-/Elektronikentwicklung"@de
		;
	cas:provides
		cas-ctx:Configuration ,
		cas-ctx:Reference ,
		cas-ctx:Variant ,
		cas-ee:ElectricElectronicComponent ,
		cas-ee:ElectricElectronicConnection ,
		cas-ee:ElectricElectronicPort
		;
	cas:uses
		cas-arch:Function ,
		cas-arch:SystemRequirement ,
		cas-mech:Body ,
		cas-mech:MechanicalComponent ,
		cas-sys:ComponentConnection ,
		cas-sys:ComponentInterface ,
		cas-sys:ComponentState ,
		cas-sys:SystemComponent
		;
	skos:definition """In Electrical/Electronic Design, all electrical and electronic products functions will be implemented through electrical and electonic components selection and allocation, circuit board design, and wire and harness routing.
Electrical/Electronic Design is usually performed using an electrical/electronic CAD system."""@en ;
	.

<http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ProductDesign/ElectricalMechanicalDesignCollaboration>
	a owl:Class ;
	rdfs:subClassOf cas:Activity ;
	rdfs:label
		"Electrical/Mechanical Design Collaboration"@en ,
		"Zusammenarbeit Elektrik/Mechanik-Konstruktion"@de
		;
	cas:uses
		cas-ee:ElectricElectronicComponent ,
