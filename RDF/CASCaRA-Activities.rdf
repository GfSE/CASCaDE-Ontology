		<cas:uses rdf:resource="&mech;SurfaceTexture"/>
		<cas:uses rdf:resource="&mech;Thread"/>
		<skos:definition xml:lang="en">Manufacturing of single parts using a variety of production processes and methods, each with specific sets of data, such as CNC programs, bending specification, holes specifications, joining features, etc.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&man;ProductAssembly">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="de">Montage</rdfs:label>
		<rdfs:label xml:lang="en">Product Assembly</rdfs:label>
