		<rdfs:label xml:lang="de">Fehlermöglichkeiten und -einfluss analysieren (D-FMEA)</rdfs:label>
	</owl:Class>
	
	<owl:Class rdf:about="&con;AssessFunctionalSafety">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
