		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "Includes entities that provide context in which related elements are valid, i. e. Revision or Configuration."
			},
			{
				"@language" : "de",
				"@value" : "Umfasst Elemente, die einen Kontext repräsentieren, in welchem verknüpfte Elemente gültig sind, z. B. Revision oder Konfiguration."
			}
			
		],
