	dcterms:title "CASCaRA Metamodel & Semantic Infrastructure" ;
	owl:versionInfo "1.0" ;
	.

cas:Activity
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Activity"@en ,
		"Prozessschritt"@de
		;
	skos:definition
		"A CASCaRA activity that uses CASCaRA entities and provides CASCaRA entities as result."@en ,
		"Ein CASCaRA-Prozessschritt, der CASCaRA-Entities verwendet und CASCaRA-Entities als Ergebnis bereitstellt."@de
		;
	.

cas:Activity_Shape
	a sh:NodeShape ;
	sh:property
		cas:provides_Shape ,
		cas:uses_Shape
		;
	sh:targetClass cas:Activity ;
	.

cas:Entity
	a owl:Class ;
	rdfs:label
		"Element"@de ,
		"Entity"@en
		;
	skos:definition
		"Represents an entity as part of the CASCaRA semantic infrastructure."@en ,
		"Repräsentiert ein Element als Bestandteil der CASCaRA semantischen Infrastruktur."@de
		;
	.

cas:EntityGroup
	a owl:Class ;
	rdfs:label
		"Groupe of entities"@en ,
		"Gruppe von Elementen"@de
		;
	skos:definition
		"Represents a group of entities as part of the CASCaRA semantic infrastructure."@en ,
		"Repräsentiert eine Gruppe von Elementen als Bestandteil der CASCaRA semantischen Infrastruktur."@de
		;
	.

cas:EntityGroup_Shape
	a sh:NodeShape ;
	sh:property
		cas:definition_Shape ,
		cas:hasPart_Shape ,
		cas:label_Shape
		;
	sh:targetClass cas:Entity ;
	.

cas:Entity_Shape
	a sh:NodeShape ;
	sh:property
		cas:definition_Shape ,
		cas:label_Shape
		;
	sh:targetClass cas:Entity ;
	.

cas:Link
	a owl:ObjectProperty ;
	rdfs:label
		"linked to"@en ,
		"verknüpft mit"@de
		;
	rdfs:domain cas:Relationship ;
	rdfs:range cas:Entity ;
	skos:definition
		"Represents a link as part of the CASCaRA semantic infrastructure."@en ,
		"Repräsentiert eine Verknüpfung als Bestandteil der CASCaRA semantischen Infrastuktur."@de
		;
	.

cas:Link_Shape
	a sh:PropertyShape ;
	sh:path cas:Link ;
	sh:property
		cas:definition_Shape ,
		cas:label_Shape
		;
	.

cas:Organizer
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Hierarchieelement"@de ,
		"Organizer"@en
		;
	skos:definition
		"An element organizing model elements. An example is a list of requirements or a diagram using a certain notation."@en ,
		"Ein Element, das andere Elemente organisiert. Beispielsweise eine Liste von Anforderungen oder ein Diagramm mit einer bestimmten Notation."@de
		;
	.

cas:Organizer_Shape
	a sh:NodeShape ;
	sh:property
		cas:Category_Shape ,
		cas:comment_Shape ,
		cas:label_Shape
		;
	sh:targetClass cas:Organizer ;
	.

cas:Outline
	a owl:Class ;
	rdfs:subClassOf cas:Organizer ;
	rdfs:label
		"Gliederung"@de ,
		"Outline"@en
		;
	skos:definition
		"A subclass of CASCaRA organizer comprising all information items of a human-readable document. As usual, the outline is hierarchically organized."@en ,
		"Eine Subklasse des CASCaRA-Organizers, die alle Informationselemente eines menschenlesbaren Dokuments zusammenfasst."@de
		;
	.

cas:Outline_Shape
	a sh:NodeShape ;
	sh:property
		cas:comment_Shape ,
		cas:label_Shape
		;
	sh:targetClass cas:Outline ;
	.

cas:Package
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Package"@en ,
		"Paket"@de
		;
	skos:definition
		"A CASCaRA package that includes all CASCaRA entities and relationships selected for a defined purpose."@en ,
		"Ein CASCaRA-Paket, das alle CASCaRA-Entities und -Relationen für einen bestimmten Zweck umfasst."@de
		;
	.

cas:Package_Shape
	a sh:NodeShape ;
	sh:targetClass cas:Package ;
	.

cas:Property
	a owl:DatatypeProperty ;
	rdfs:label "Property"@en ;
	skos:definition
		"A CASCaRA meta-model item used for properties (aka attributes)."@en ,
		"Repräsentiert."@de
		;
	.

cas:Property_Shape
	a sh:PropertyShape ;
	sh:datatype xsd:anyType ;
	sh:path cas:Property ;
	.

cas:Relationship
	a owl:Class ;
	rdfs:label
		"Relation"@de ,
		"Relationship"@en
		;
	skos:definition
		"Represents a Relationship between two Entities as part of the CASCaRA semantic infrastructure."@en ,
		"Repräsentiert eine Relation zwischen zwei Entitäten als Bestandteil der CASCaRA semantischen Infrastruktur."@de
		;
	.

cas:Relationship_Shape
	a sh:NodeShape ;
	sh:property
		cas:definition_Shape ,
		cas:label_Shape ,
		cas:linksSource_Shape ,
		cas:linksTarget_Shape
		;
	sh:targetClass cas:Relationship ;
	.

cas:comment_Shape
	a sh:PropertyShape ;
	sh:path rdfs:comment ;
	.

cas:definition_Shape
	a sh:PropertyShape ;
	sh:minCount "1"^^xsd:integer ;
	sh:path skos:definition ;
	.

cas:hasPart_Shape
	a sh:PropertyShape ;
	sh:path dcterms:hasPart ;
	.

cas:label_Shape
	a sh:PropertyShape ;
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:label ;
	.

cas:linksSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label
		"to source"@en ,
		"zu Quelle"@de
		;
	rdfs:domain cas:Relationship ;
	rdfs:range cas:Entity ;
	skos:definition
		"Connects the source entity of a reified relationship."@en ,
		"Verbindet das Quellobjekt einer reifizierten Relation."@de
		;
	.

cas:linksSource_Shape
	a sh:PropertyShape ;
	sh:path cas:linksSource ;
	.

cas:linksTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label
		"to target"@en ,
		"zu Ziel"@de
		;
	rdfs:domain cas:Relationship ;
	rdfs:range cas:Entity ;
	skos:definition
		"Connects the target entity of a reified relationship."@en ,
		"Verbindet das Zielobjekt einer reifizierten Relation."@de
		;
	.

cas:linksTarget_Shape
	a sh:PropertyShape ;
	sh:class cas:Entity ;
	sh:path cas:linksTarget ;
	.

cas:provides
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label
		"provides"@en ,
		"stellt bereit"@de
		;
	skos:definition
		"A CASCaRA Link that relates to CASCaRA entities provided by this activity."@en ,
		"CASCaRA-Link, der auf CASCaRA-Entities verweist, welche von diesem Prozessschritt bereitgestellt werden."@de
		;
	.

cas:provides_Shape
	a sh:PropertyShape ;
	sh:class cas:Entity ;
	sh:path cas:provides ;
	.

cas:uses
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label
		"uses"@en ,
		"verwendet"@de
		;
	skos:definition
		"A CASCaRA Link that relates to CASCaRA entities used by this activity."@en ,
		"CASCaRA-Link, der auf CASCaRA-Entities verweist, welche in diesem Prozessschritt verwendet werden."@de
		;
	.

cas:uses_Shape
	a sh:PropertyShape ;
	sh:class cas:Entity ;
	sh:path cas:uses ;
	.

