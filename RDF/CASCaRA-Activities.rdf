		<cas:uses rdf:resource="&sys;ComponentConnection"/>
		<cas:uses rdf:resource="&sys;ComponentInterface"/>
		<cas:uses rdf:resource="&sys;ComponentState"/>
		<cas:uses rdf:resource="&sys;SystemComponent"/>
		<skos:definition xml:lang="en">In Mechanical Design, physical product structure, product geometry, as well as all specifications are defined.
This includes shape, dimensioning and tolerancing, material (including semi-finished parts and treatment), surface and edge specifications.
Mechanical design is usually conducted using a mechanical CAD system.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductDevelopment/ProductDesign/SoftwareEngineering">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Software Engineering</rdfs:label>
		<rdfs:label xml:lang="de">Softwareentwicklung</rdfs:label>
		<cas:provides rdf:resource="&ctx;Configuration"/>
		<cas:provides rdf:resource="&ctx;Reference"/>
		<cas:provides rdf:resource="&ctx;Variant"/>
