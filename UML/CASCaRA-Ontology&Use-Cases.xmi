			<element xmi:idref="EAID_CA5637F5_ADFD_4c50_B9A7_8CFC78FDCA77" xmi:type="uml:Class" name="Validation Plan" scope="public">
				<model package="EAPK_A5F2A941_DB19_4616_AE4F_EA80425AB96A" tpos="2" ea_localid="21355" ea_eleType="element"/>
				<properties documentation="en: A specific executable test that examines all aspects including inputs and outputs of a system and then provides a detailed description of the steps that should be taken, the results that should be achieved, and other elements that should be identified. Steps explained in a test case include all details even if they are assumed to be common knowledge. Test cases are used as a technical explanation and reference guide for systems.&#xA;https://intranet.prostep.org/display/PROJ/Glossary&#xA;de: Ein spezifischer, ausführbarer Test, der alle Aspekte, einschließlich der Eingaben und Ausgaben eines Systems, untersucht und dann eine detaillierte Beschreibung der Schritte, die durchgeführt werden sollten, der Ergebnisse, die erzielt werden sollten, und anderer Elemente, die identifiziert werden sollten, liefert. Die in einem Testfall erläuterten Schritte umfassen alle Details, auch wenn sie als allgemein bekannt vorausgesetzt werden. Testfälle werden als technische Erklärung und Referenz für Systeme verwendet.&#xA;&#xA;Recommendations&#xA;Identifier: identifier&#xA;Key: title&#xA;Label: title" isSpecification="false" sType="Class" nType="0" alias="Validation Plan" scope="public" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="kirsch" version="1.0" phase="1.0" created="2026-07-16 01:34:56" modified="2026-07-16 01:34:56" complexity="1" status="Proposed"/>
				<code/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
