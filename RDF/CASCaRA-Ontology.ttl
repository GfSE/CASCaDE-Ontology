<svg xmlns="http://www.w3.org/2000/svg" xmlns:xml="http://www.w3.org/XML/1998/namespace" viewBox="0 0 24 24">
	<g class="outline">
		<rect x="4.5" y="4.5" width="10" height="5"/>
		<rect x="4.5" y="9.5" width="10" height="5"/>
		<rect x="4.5" y="14.5" width="10" height="5"/>
