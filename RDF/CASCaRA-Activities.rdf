	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/CasCara">
		<rdfs:subClassOf rdf:resource="http://www.omg.org/spec/CASCaRA/metamodel/Entity"/>
		<rdfs:label xml:lang="en">CASCaRA</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2025-08-02T18:06:47Z</dcterms:modified>
		<skos:definition xml:lang="en">Collaborative Artifact, Specification, Context and Resource Access</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;CoSimulationEarlyRequirementsVV">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Co-Simulation &amp; early Requirements V&amp;V</rdfs:label>
		<rdfs:label xml:lang="de">Software Engineer V&amp;V/Simulation Egineer</rdfs:label>
		<skos:definition xml:lang="en">Establish method and tool to Co-simulate systems, assembling suppliers&apos; sub-systems into a systems integration model, used to perform early design and requirements Verification &amp; Validation. Incorporate Supplier inputs into Safety analysis.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;Collaborative3dMbdElectricalAndSoftwareDesignCoDevelopment">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Collaborative 3D MBD, Electrical and Software Design Co-Development</rdfs:label>
		<rdfs:label xml:lang="de">Mechanical Design Engineer</rdfs:label>
		<skos:definition xml:lang="en">Establish method and tool to collaboratively develop and manage 3D MBD and E-BOM connected to the Requirements, Functional and Logical Archtecture (L-BOM)</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;CollaborativeArchitectureDesignCoDevelopment">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Collaborative Architecture Design Co-Development</rdfs:label>
		<rdfs:label xml:lang="de">Systems Engineer. Design Engineer.</rdfs:label>
		<cas:provides rdf:resource="&arch;Function"/>
		<cas:provides rdf:resource="&arch;SystemRequirement"/>
		<cas:provides rdf:resource="&sys;ComponentConnection"/>
		<cas:provides rdf:resource="&sys;ComponentInterface"/>
		<cas:provides rdf:resource="&sys;ComponentState"/>
		<cas:provides rdf:resource="&sys;Deviation"/>
		<cas:provides rdf:resource="&sys;SystemComponent"/>
		<skos:definition xml:lang="en">Establish and maintain a method and tool to collaboratively define a system and sub-system architecture &amp; interfaces where supplier provided work products are integrated. Including mission, operational architecture, functional architecture, logical architecture and interface (ICD) definition.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;CollaborativeDigitalProductQualityManagementApqp">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Collaborative Digital Product Quality Management (APQP)</rdfs:label>
		<rdfs:label xml:lang="de">QA Engineer, Production Engineer</rdfs:label>
		<skos:definition xml:lang="en">Establish process and tool for the  creation, definition, retention of APQP (Advanced Product Quality Planning ) and PPAP (Production part approval process) elements, following indutsry standards such as AS9145.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;CollaborativeManufacturingEngineering">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Collaborative Manufacturing Engineering</rdfs:label>
		<rdfs:label xml:lang="de">Industrial Engineer. Production Engineer</rdfs:label>
		<skos:definition xml:lang="en">Establish process and tool for Collabrative Manufacturing MBD: M-BOM, manufacturing process planning and model based work instruction MBI, connected to the 3D MBD</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;CollaborativeProductRequirementsManagement">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Collaborative Product Requirements Management</rdfs:label>
		<cas:provides rdf:resource="&arch;Requirement"/>
		<cas:provides rdf:resource="&arch;StakeholderRequirement"/>
		<cas:uses rdf:resource="&org;Role"/>
		<cas:uses rdf:resource="&arch;UseCase"/>
		<skos:definition xml:lang="en">Establish and maintain a requirements management process in common with the supplier. Approve requirements specifications (&quot;model based SCD&quot;) , get change alerts, manage change requests &amp; releases between OEM and supplier</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;LotarLongTermArchivingAndRetrieval">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="de">Engineer, future program</rdfs:label>
		<rdfs:label xml:lang="en">LOTAR Long-term Archiving and Retrieval</rdfs:label>
		<skos:definition xml:lang="en">I want to preserve a baseline of system informationt for later retrieval and reuse. Reference: https://lotar-international.org/</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&cas;ModelBasedAcquisition">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="de">Defense acquirer Defense contratctor</rdfs:label>
		<rdfs:label xml:lang="en">Model-based Acquisition</rdfs:label>
		<skos:definition xml:lang="en">Reference: https://www.omg.org/communities/model-based-acquisition-user-community.htm</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/CollaborationUseCases">
		<rdfs:subClassOf rdf:resource="http://www.omg.org/spec/CASCaRA/metamodel/Entity"/>
		<rdfs:label xml:lang="en">Collaboration Use-Cases</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2023-10-22T08:44:10Z</dcterms:modified>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/ConceptDefinition">
		<rdfs:subClassOf rdf:resource="http://www.omg.org/spec/CASCaRA/metamodel/Entity"/>
		<rdfs:label xml:lang="en">Concept definition</rdfs:label>
		<rdfs:label xml:lang="de">Konzeptdefinition</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2022-02-18T11:17:54Z</dcterms:modified>
		<skos:definition xml:lang="en">In conceptual design, new products or systems are defined through requirements and specified through a functional structure in mechanical, electrics/electronics, and software domains. A logical structure specifies the future product architecture in order to implement the specified functions.
Besides new products, existing products may be changed or modified significantly to better comply with customer needs, or to attract new customers. Eventually, the product may be changed or adopted to comply to new standards, regulations or laws.
Conceptual design is usually performed at a high abstraction level and low level of detail, using parameter studies, system models, and rough geometry, if any.
For the Digital Data Package, model-based methods and data for product conceptual design are assumed.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage">
		<rdfs:subClassOf rdf:resource="http://www.omg.org/spec/CASCaRA/metamodel/Entity"/>
		<rdfs:label xml:lang="en">Digital Data Package</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2022-03-23T05:20:38Z</dcterms:modified>
	</owl:Class>
	
	<owl:Class rdf:about="&col;LongTermArchiving">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="de">Langzeitarchivierung</rdfs:label>
		<rdfs:label xml:lang="en">Long-Term Archiving</rdfs:label>
		<cas:uses rdf:resource="&proc;JoiningProcess"/>
		<cas:uses rdf:resource="&arch;Function"/>
		<cas:uses rdf:resource="&arch;StakeholderRequirement"/>
		<cas:uses rdf:resource="&arch;SystemRequirement"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;KinematicJoint"/>
		<cas:uses rdf:resource="&mech;KinematicMechanism"/>
		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&mech;ModelAnnotation"/>
		<cas:uses rdf:resource="&sys;ComponentConnection"/>
		<cas:uses rdf:resource="&sys;ComponentInterface"/>
		<cas:uses rdf:resource="&sys;ComponentState"/>
		<cas:uses rdf:resource="&sys;Deviation"/>
		<cas:uses rdf:resource="&sys;SystemComponent"/>
		<cas:uses rdf:resource="&val;Displacement"/>
		<cas:uses rdf:resource="&val;ValidationResult"/>
		<cas:uses rdf:resource="&val;ValidationRun"/>
		<cas:uses rdf:resource="&ver;VerificationResult"/>
		<cas:uses rdf:resource="&ver;VerificationRun"/>
		<skos:definition xml:lang="en">For long-term archiving, all product information must be configured and stored in a retrievable way. Product information includes domain-specifc models, relations between models and model entities, and meta-data about the documents and models.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&man;PackagingLogistics">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Packaging &amp; Logistics</rdfs:label>
		<rdfs:label xml:lang="de">Verpackung &amp; Logistik</rdfs:label>
		<cas:uses rdf:resource="&proc;JoiningProcess"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticConnection"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticPort"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<skos:definition xml:lang="en">Includes the definition of all kinds of packaging and transport equipment to ensure a product or its components will be supplied to their destination safely.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&man;PartsManufacturing">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Parts Manufacturing</rdfs:label>
		<rdfs:label xml:lang="de">Teilefertigung</rdfs:label>
		<cas:uses rdf:resource="&mnf;ManufacturingEquipmentComponent"/>
		<cas:uses rdf:resource="&proc;ManufacturingOperation"/>
		<cas:uses rdf:resource="&mech;BendingSpecification"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;Cleanliness"/>
		<cas:uses rdf:resource="&mech;Datum"/>
		<cas:uses rdf:resource="&mech;DimensionalSize"/>
		<cas:uses rdf:resource="&mech;Gearing"/>
