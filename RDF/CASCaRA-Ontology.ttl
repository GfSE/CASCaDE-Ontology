	dcterms:title "CASCaRA Domain Ontology" ;
	owl:imports <http://www.omg.org/spec/CASCaRA/metamodel/> ;
	owl:versionInfo "1.0" ;
	.

dc:description
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Property ;
	rdfs:label
		"Beschreibung"@de ,
		"Description"@en
		;
	dcterms:modified "2026-06-30T00:23:38Z"^^xsd:dateTime ;
	rdfs:range xsd:string ;
	skos:definition
		"Beschreibung des Elements"@de ,
		"Description of the element"@en
		;
	.

dc:description_Shape
	a sh:PropertyShape ;
	sh:datatype xsd:string ;
	sh:path dc:description ;
	.

dc:identifier
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Property ;
	rdfs:label
		"Identifier"@en ,
		"Identifikator"@de
		;
	dcterms:modified "2026-06-30T00:23:33Z"^^xsd:dateTime ;
	rdfs:range xsd:string ;
	skos:definition
		"Eindeutiger Identifikator des Elements"@de ,
		"Unambiguous identifier of the element"@en
		;
	.

dc:identifier_Shape
	a sh:PropertyShape ;
	sh:datatype xsd:string ;
	sh:path dc:identifier ;
	.

dc:title
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cas:Property ;
	rdfs:label
		"Titel"@de ,
		"Title"@en
		;
	dcterms:modified "2026-06-30T00:23:36Z"^^xsd:dateTime ;
	rdfs:range xsd:string ;
	skos:definition
		"Titel des Elements"@de ,
		"Title of the element"@en
		;
	.

dc:title_Shape
	a sh:PropertyShape ;
	sh:datatype xsd:string ;
	sh:path dc:title ;
	.

cas-ctx:Change
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Change"@en ,
		"Änderung"@de
		;
	dcterms:modified "2025-09-28T17:35:57Z"^^xsd:dateTime ;
	skos:definition
		"A change in requirements, engineering, planning or production"@en ,
		"Änderung in Anforderungen, Entwicklung, Planung oder Produktion"@de
		;
	.

cas-ctx:Change_Shape
	a sh:NodeShape ;
	sh:property
		dc:description_Shape ,
		dc:identifier_Shape ,
		dc:title_Shape ,
		:endDateTime_Shape ,
		:number_Shape ,
		:startDateTime_Shape ,
		:type_Shape
		;
	sh:targetClass cas-ctx:Change ;
	.

