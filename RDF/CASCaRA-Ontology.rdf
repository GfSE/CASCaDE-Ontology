	<owl:Class rdf:about="&cas-sw;SoftwareComponent">
		<rdfs:subClassOf rdf:resource="&cas-sys;SystemComponent"/>
		<rdfs:label xml:lang="en">Software Component</rdfs:label>
		<rdfs:label xml:lang="de">Softwarekomponente</rdfs:label>
