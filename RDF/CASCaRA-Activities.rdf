		<skos:definition xml:lang="en">Simulation execution includes performing the simulation as well as documenting and summarizing the simulation results.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductDevelopment/VerificationValidationUsingSimulation/PlanAndPrepareSimulation">
