		<rdfs:label xml:lang="de">Zerlegung &amp; Recycling</rdfs:label>
		<cas:uses rdf:resource="&proc;JoiningProcess"/>
		<cas:uses rdf:resource="&arch;Function"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicComponent"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicConnection"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicPort"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticConnection"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticPort"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;Hole"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&mech;PaintedCoatedArea"/>
		<cas:uses rdf:resource="&mech;Thread"/>
		<skos:definition xml:lang="en">Includes all end-of-life activities required to putting a product or its component to recycling.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductOperation/MaintenanceService">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Maintenance &amp; Service</rdfs:label>
		<rdfs:label xml:lang="de">Wartung &amp; Instandhaltung</rdfs:label>
		<cas:uses rdf:resource="&proc;JoiningProcess"/>
		<cas:uses rdf:resource="&arch;Function"/>
		<cas:uses rdf:resource="&arch;UseCase"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicComponent"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicConnection"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicPort"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticConnection"/>
		<cas:uses rdf:resource="&fld;HydraulicPneumaticPort"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&sw;SoftwareClass"/>
		<cas:uses rdf:resource="&sw;SoftwareComponent"/>
		<cas:uses rdf:resource="&sw;SoftwareInterface"/>
		<skos:definition xml:lang="en">Includes all activities performed in order to maintain a product in operation.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductOperation/ProductUsage">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Product Usage</rdfs:label>
		<rdfs:label xml:lang="de">Produktnutzung</rdfs:label>
