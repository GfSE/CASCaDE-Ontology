f36d94e1ce5e4307acf8e9d7:Requirement_2-2-2-2_Available-Power dc:description "The Mars Rover shall be operable for 4h under all of the following conditions:* The energy storage is fully loaded at the beginning* The operation requires less than or equal to 60% of the max energy in peak load* the environmental conditions are mission normal";
                                                             dc:identifier "_17_0_3_1_60c0217_1554373992768_101922_18958";
                                                             dc:title "Available Power";
                                                             :number "2.2.2.2";
