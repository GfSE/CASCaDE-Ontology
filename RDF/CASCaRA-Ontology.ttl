	skos:definition
		"A change in requirements, engineering, planning or production"@en ,
		"Änderung in Anforderungen, Entwicklung, Planung oder Produktion"@de
		;
	.

cas-ctx:Change_Shape
	a sh:NodeShape ;
	sh:property
		:description_Shape ,
		:endDateTime_Shape ,
		:identifier_Shape ,
		:number_Shape ,
		:startDateTime_Shape ,
		:title_Shape ,
		:type_Shape
		;
	sh:targetClass cas-ctx:Change ;
	.

