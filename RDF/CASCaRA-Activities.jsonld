	{
		"@id" : "cas-act:ProductDesign",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Product Design"
			},
			{
				"@language" : "de",
				"@value" : "Produktentwurf"
			}
			
		],
		"dcterms:modified" : {
			"@type" : "xsd:dateTime",
			"@value" : "2021-11-29T12:59:20Z"
		},
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Product Design is the specific synthesis, implentation and documentation of design solutions suggested by systems engineering.\u000d\u000aProduct design comprises the domain-specific design processes of mechanical, electrical/electronical design, and software engineering."
		},
		"@context" : {
			"cas-act" : "http://www.omg.org/spec/CASCaRA/activities/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"dcterms" : "http://purl.org/dc/terms/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas-act:ProductDevelopment",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Product Development"
			},
			{
				"@language" : "de",
				"@value" : "Produktentwicklung"
			}
			
		],
		"dcterms:modified" : {
			"@type" : "xsd:dateTime",
			"@value" : "2022-02-18T11:15:52Z"
		},
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Product development is the creation of products with new or modified characteristics that offer new or additional benefits to the customer, or comply with new or changed standards, rules and regulations.\u000d\u000aProduct development may involve modification of an existing product or its presentation or formulation of an entirely new product that satisfies a newly-defined or changed customer need or market segment.\u000d\u000aDescription based on: https://cio-wiki.org/wiki/Product_Development"
		},
		"@context" : {
			"cas-act" : "http://www.omg.org/spec/CASCaRA/activities/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"dcterms" : "http://purl.org/dc/terms/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas-con:AnalyzeDesignFailureModesAndEffectsDFmea",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Analyze design failure modes and effects (D-FMEA)"
			},
			{
				"@language" : "de",
				"@value" : "Fehlermöglichkeiten und -einfluss analysieren (D-FMEA)"
			}
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Design Failure Modes and Effects Analysis (D-FMEA) is performed to systematically identify and evaluate potential failure modes in a product design before implementation. It assesses the impact, causes, and likelihood of failures, enabling teams to prioritize risks and define corrective actions early in the development process. This proactive approach improves product reliability, safety, and overall design quality while reducing development costs and rework."
		},
		"@context" : {
			"cas-con" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ConceptDefinition/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas-con:AssessFunctionalSafety",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Assess functional safety"
			},
			{
				"@language" : "de",
				"@value" : "Funktionale Sicherheit bewerten"
			}
			
		],
		"cas:provides" : [
			{ "@id" : "cas-arch:Function" },
			{ "@id" : "cas-sys:ComponentConnection" },
			{ "@id" : "cas-sys:ComponentInterface" },
			{ "@id" : "cas-sys:ComponentState" },
			{ "@id" : "cas-sys:Deviation" },
			{ "@id" : "cas-sys:SystemComponent" }
			
		],
		"cas:uses" : [
			{ "@id" : "cas-org:Role" },
			{ "@id" : "cas-arch:Function" },
			{ "@id" : "cas-arch:SystemRequirement" },
			{ "@id" : "cas-arch:UseCase" },
			{ "@id" : "cas-sys:ComponentConnection" },
			{ "@id" : "cas-sys:ComponentInterface" },
			{ "@id" : "cas-sys:ComponentState" },
			{ "@id" : "cas-sys:SystemComponent" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "A Functional Safety Assessment (FSA) is conducted to independently evaluate whether a product, system, or process complies with applicable functional safety standards and safety requirements throughout its lifecycle. The assessment verifies the effectiveness of safety activities, identifies potential gaps, and provides evidence that safety objectives have been achieved before release or operation. It supports risk reduction and strengthens confidence in the safety integrity of the overall system."
		},
		"@context" : {
			"cas-con" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ConceptDefinition/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"cas-org" : "http://www.omg.org/spec/CASCaRA/ontology/Organization/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#",
			"cas-sys" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SystemsDesign/"
		}
	},
	{
		"@id" : "cas-con:BusinessOrMissionAnalysis",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Business or Mission Analysis"
			},
			{
				"@language" : "de",
				"@value" : "Geschäfts- oder Einsatzanalyse"
			}
			
		],
		"cas:provides" : [
			{ "@id" : "cas-org:Role" },
			{ "@id" : "cas-arch:UseCase" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Product Planning is the ongoing process of identifying and articulating market requirements that define a product's feature set. Product planning serves as the basis for decisions about price, distribution and promotion.\u000aProduct planning is the process of creating a product idea and following through on it until the product is introduced to the market. Additionally, a small company must have an exit strategy for its product in case the product does not sell.\u000aProduct planning entails managing the product throughout its life using various marketing strategies, including product extensions or improvements, increased distribution, price changes and promotions.\u000a\u000d\u000aAlso includes the identification of relevant legal requirements as well as customs and tax regulations applicable to the product and the respective target markets.\u000d\u000aDescription based on: https://en.wikipedia.org/wiki/Product_planning"
		},
		"@context" : {
			"cas-con" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ConceptDefinition/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"cas-org" : "http://www.omg.org/spec/CASCaRA/ontology/Organization/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas-con:DefineSystemsArchitecture",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Define systems Architecture"
			},
			{
				"@language" : "de",
				"@value" : "Systemarchitektur definieren"
			}
			
		],
		"cas:provides" : [
			{ "@id" : "cas-arch:Function" },
			{ "@id" : "cas-sys:ComponentConnection" },
			{ "@id" : "cas-sys:ComponentInterface" },
			{ "@id" : "cas-sys:ComponentState" },
			{ "@id" : "cas-sys:Deviation" },
			{ "@id" : "cas-sys:SystemComponent" }
			
		],
		"cas:uses" : [
			{ "@id" : "cas-org:Role" },
			{ "@id" : "cas-arch:StakeholderRequirement" },
			{ "@id" : "cas-arch:UseCase" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Systems architecture refers to the cross-domain definition of functions and logical structures at systems level, that will be pursued in detail by the individual domains mechanical design, electric/electronic design and software design."
		},
		"@context" : {
			"cas-con" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ConceptDefinition/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"cas-org" : "http://www.omg.org/spec/CASCaRA/ontology/Organization/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#",
			"cas-sys" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SystemsDesign/"
		}
	},
	{
		"@id" : "cas-con:RequirementsEngineering",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "de",
				"@value" : "Anforderungsmanagement"
			},
			{
				"@language" : "en",
				"@value" : "Requirements Engineering"
			}
			
		],
		"cas:provides" : { "@id" : "cas-arch:Requirement" },
		"cas:uses" : [
			{ "@id" : "cas-org:Role" },
			{ "@id" : "cas-arch:UseCase" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Requirements engineering is the process of defining, eliciting, documenting, and maintaining requirements in the engineering design process.\u000d\u000aDescription based on: https://en.wikipedia.org/wiki/Requirements_engineering"
		},
		"@context" : {
			"cas-con" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ConceptDefinition/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"cas-org" : "http://www.omg.org/spec/CASCaRA/ontology/Organization/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ProductDesign/ElectricalElectronicalDesign",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Electrical/Electronical Design"
			},
			{
				"@language" : "de",
				"@value" : "Elektrik-/Elektronikentwicklung"
			}
			
		],
		"cas:provides" : [
			{ "@id" : "cas-ctx:Configuration" },
			{ "@id" : "cas-ctx:Reference" },
			{ "@id" : "cas-ctx:Variant" },
			{ "@id" : "cas-ee:ElectricElectronicComponent" },
			{ "@id" : "cas-ee:ElectricElectronicConnection" },
			{ "@id" : "cas-ee:ElectricElectronicPort" }
			
		],
		"cas:uses" : [
			{ "@id" : "cas-arch:Function" },
			{ "@id" : "cas-arch:SystemRequirement" },
			{ "@id" : "cas-mech:Body" },
			{ "@id" : "cas-mech:MechanicalComponent" },
			{ "@id" : "cas-sys:ComponentConnection" },
			{ "@id" : "cas-sys:ComponentInterface" },
			{ "@id" : "cas-sys:ComponentState" },
			{ "@id" : "cas-sys:SystemComponent" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "In Electrical/Electronic Design, all electrical and electronic products functions will be implemented through electrical and electonic components selection and allocation, circuit board design, and wire and harness routing.\u000d\u000aElectrical/Electronic Design is usually performed using an electrical/electronic CAD system."
		},
		"@context" : {
			"cas-ee" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/ElectricElectronicDesign/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-ctx" : "http://www.omg.org/spec/CASCaRA/ontology/ContextElements/",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#",
			"cas-sys" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SystemsDesign/",
			"cas-mech" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/MechanicalDesign/"
		}
	},
	{
		"@id" : "http://www.omg.org/spec/CASCaRA/activities/ProductDevelopment/ProductDesign/ElectricalMechanicalDesignCollaboration",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Electrical/Mechanical Design Collaboration"
			},
			{
				"@language" : "de",
				"@value" : "Zusammenarbeit Elektrik/Mechanik-Konstruktion"
			}
			
		],
		"cas:uses" : [
			{ "@id" : "cas-ee:ElectricElectronicComponent" },
			{ "@id" : "cas-ee:ElectricElectronicConnection" },
			{ "@id" : "cas-ee:ElectricElectronicPort" },
			{ "@id" : "cas-mech:Body" },
			{ "@id" : "cas-mech:MechanicalComponent" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "In Electrical/Mechanical Design Collaboration, both design disciplines involved will collaborate in a common 3D space in order to adjust and coordinate allocation, dimensioning and positioning of components."
		},
		"@context" : {
			"cas-ee" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/ElectricElectronicDesign/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#",
			"cas-mech" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/MechanicalDesign/"
		}
	},
	{
