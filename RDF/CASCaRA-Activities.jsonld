		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "Assembly of components or products from single parts or sub-components according to a production plan, using all kinds of joinig and bonding."
		},
		"@context" : {
			"cas-proc" : "http://www.omg.org/spec/CASCaRA/ontology/ManufacturingSupplyChain/ManufacturingProcess/",
