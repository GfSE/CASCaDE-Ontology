	</owl:Ontology>
	
	<owl:Class rdf:about="&cas;Activity">
		<rdfs:label xml:lang="en">Activity</rdfs:label>
		<rdfs:label xml:lang="de">Prozessschritt</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA activity that relates to data entities delivered or required by this use-case.</skos:definition>
		<skos:definition xml:lang="de">Ein CASCaRA-Prozess, der sich auf Entities bezieht, die im Rahmen dieses Anwendungsfalls bereitgestellt oder benötigt werden.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Activity_Shape">
		<sh:property rdf:nodeID="blank19"/>
		<sh:property rdf:nodeID="blank20"/>
		<sh:targetClass rdf:resource="&cas;Activity"/>
	</sh:NodeShape>
	
	<owl:Class rdf:about="&cas;Entity">
		<rdfs:label xml:lang="en">Entity</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA meta-model item used for entities.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Entity_Shape">
		<sh:property rdf:nodeID="blank24"/>
		<sh:property rdf:nodeID="blank26"/>
		<sh:targetClass rdf:resource="&cas;Entity"/>
	</sh:NodeShape>
	
	<owl:ObjectProperty rdf:about="&cas;Link">
		<rdfs:label xml:lang="en">linked with</rdfs:label>
		<rdfs:range rdf:nodeID="blank13"/>
		<skos:definition xml:lang="en">A PIG meta-model item connecting a reified relationship with its source or target. Also connects an organizer to a model element.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;Link_Shape">
		<sh:or rdf:nodeID="blank09"/>
		<sh:path rdf:resource="&cas;Link"/>
	</sh:PropertyShape>
	
	<owl:Class rdf:about="&cas;Package">
		<rdfs:subClassOf rdf:resource="&cas;Entity"/>
		<rdfs:label xml:lang="en">Package</rdfs:label>
		<rdfs:label xml:lang="de">Paket</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA meta-model item used for packages comprising entities, relationships and potentially nested packages.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Package_Shape">
		<sh:property rdf:nodeID="blank25"/>
		<sh:property rdf:nodeID="blank27"/>
		<sh:targetClass rdf:resource="&cas;Package"/>
	</sh:NodeShape>
	
	<owl:DatatypeProperty rdf:about="&cas;Property">
		<rdfs:label xml:lang="en">Property</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA meta-model item used for properties (aka attributes).</skos:definition>
	</owl:DatatypeProperty>
	
	<sh:PropertyShape rdf:about="&cas;Property_Shape">
		<sh:datatype rdf:resource="&xsd;anyType"/>
		<sh:path rdf:resource="&cas;Property"/>
	</sh:PropertyShape>
	
	<owl:ObjectProperty rdf:about="&cas;Provided">
		<rdfs:label xml:lang="de">Bereitgestellt</rdfs:label>
		<rdfs:label xml:lang="en">Provided</rdfs:label>
		<rdfs:domain rdf:resource="&cas;Activity"/>
		<rdfs:range rdf:resource="&cas;Entity"/>
	</owl:ObjectProperty>
	
	<owl:Class rdf:about="&cas;Relationship">
		<rdfs:label xml:lang="en">Relationship</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA meta-model item used for reified relationships (aka predicates).</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Relationship_Shape">
		<sh:property rdf:nodeID="blank28"/>
		<sh:property rdf:nodeID="blank29"/>
		<sh:property rdf:nodeID="blank30"/>
		<sh:targetClass rdf:resource="&cas;Relationship"/>
	</sh:NodeShape>
	
	<owl:ObjectProperty rdf:about="&cas;Used">
		<rdfs:label xml:lang="en">Used</rdfs:label>
		<rdfs:label xml:lang="de">Verwendet</rdfs:label>
		<rdfs:domain rdf:resource="&cas;Activity"/>
		<rdfs:range rdf:resource="&cas;Entity"/>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="&cas;linksSource">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">to source</rdfs:label>
		<rdfs:range rdf:nodeID="blank14"/>
		<skos:definition xml:lang="en">Connects the source of a reified relationship.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;linksSource_Shape">
		<sh:or rdf:nodeID="blank07"/>
		<sh:path rdf:resource="&cas;linksSource"/>
	</sh:PropertyShape>
	
	<owl:ObjectProperty rdf:about="&cas;linksTarget">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">to target</rdfs:label>
		<rdfs:range rdf:nodeID="blank15"/>
		<skos:definition xml:lang="en">Connects the target of a reified relationship or an organizer.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;linksTarget_Shape">
		<sh:or rdf:nodeID="blank08"/>
		<sh:path rdf:resource="&cas;linksTarget"/>
	</sh:PropertyShape>
	
