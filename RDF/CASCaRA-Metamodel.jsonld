		"dcterms:title" : {
			"@value" : "CASCaRA Metamodel & Semantic Infrastructure"
		},
		"owl:versionInfo" : {
			"@value" : "1.0"
		},
		"@context" : {
			
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"dcterms" : "http://purl.org/dc/terms/",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Activity",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Activity"
			},
			{
				"@language" : "de",
				"@value" : "Prozessschritt"
			}
			
		],
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "A CASCaRA activity that uses CASCaRA entities and provides CASCaRA entities as result."
			},
			{
				"@language" : "de",
				"@value" : "Ein CASCaRA-Prozessschritt, der CASCaRA-Entities verwendet und CASCaRA-Entities als Ergebnis bereitstellt."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Activity_Shape",
		"@type" : "sh:NodeShape",
		"sh:property" : [
			{ "@id" : "cas:provides_Shape" },
			{ "@id" : "cas:uses_Shape" }
			
		],
		"sh:targetClass" : { "@id" : "cas:Activity" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Entity",
		"@type" : "owl:Class",
		"rdfs:label" : [
			{
				"@language" : "de",
				"@value" : "Element"
			},
			{
				"@language" : "en",
				"@value" : "Entity"
			}
			
		],
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "Represents an entity as part of the CASCaRA semantic infrastructure."
			},
			{
				"@language" : "de",
				"@value" : "Repräsentiert ein Element als Bestandteil der CASCaRA semantischen Infrastruktur."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Entity_Shape",
		"@type" : "sh:NodeShape",
		"sh:property" : [
			{ "@id" : "cas:definition_Shape" },
			{ "@id" : "cas:label_Shape" }
			
		],
		"sh:targetClass" : { "@id" : "cas:Entity" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Link",
		"@type" : "owl:ObjectProperty",
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "linked to"
			},
			{
				"@language" : "de",
				"@value" : "verknüpft mit"
			}
			
		],
		"rdfs:domain" : { "@id" : "cas:Relationship" },
		"rdfs:range" : { "@id" : "cas:Entity" },
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "Represents a link as part of the CASCaRA semantic infrastructure."
			},
			{
				"@language" : "de",
				"@value" : "Repräsentiert eine Verknüpfung als Bestandteil der CASCaRA semantischen Infrastuktur."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Link_Shape",
		"@type" : "sh:PropertyShape",
		"sh:path" : { "@id" : "cas:Link" },
		"sh:property" : [
			{ "@id" : "cas:definition_Shape" },
			{ "@id" : "cas:label_Shape" }
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Organizer",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "de",
				"@value" : "Hierarchieelement"
			},
			{
				"@language" : "en",
				"@value" : "Organizer"
			}
			
		],
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "An element organizing model elements. An example is a list of requirements or a diagram using a certain notation."
			},
			{
				"@language" : "de",
				"@value" : "Ein Element, das andere Elemente organisiert. Beispielsweise eine Liste von Anforderungen oder ein Diagramm mit einer bestimmten Notation."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Organizer_Shape",
		"@type" : "sh:NodeShape",
		"sh:property" : [
			{ "@id" : "cas:Category_Shape" },
			{ "@id" : "cas:comment_Shape" },
			{ "@id" : "cas:label_Shape" }
			
		],
		"sh:targetClass" : { "@id" : "cas:Organizer" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Outline",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Organizer" },
		"rdfs:label" : [
			{
				"@language" : "de",
				"@value" : "Gliederung"
			},
			{
				"@language" : "en",
				"@value" : "Outline"
			}
			
		],
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "A subclass of CASCaRA organizer comprising all information items of a human-readable document. As usual, the outline is hierarchically organized."
			},
			{
				"@language" : "de",
				"@value" : "Eine Subklasse des CASCaRA-Organizers, die alle Informationselemente eines menschenlesbaren Dokuments zusammenfasst."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Outline_Shape",
		"@type" : "sh:NodeShape",
		"sh:property" : [
			{ "@id" : "cas:comment_Shape" },
			{ "@id" : "cas:label_Shape" }
			
		],
		"sh:targetClass" : { "@id" : "cas:Outline" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Package",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Package"
			},
			{
				"@language" : "de",
				"@value" : "Paket"
			}
			
		],
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "A CASCaRA package that includes all CASCaRA entities and relationships selected for a defined purpose."
			},
			{
				"@language" : "de",
				"@value" : "Ein CASCaRA-Paket, das alle CASCaRA-Entities und -Relationen für einen bestimmten Zweck umfasst."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Package_Shape",
		"@type" : "sh:NodeShape",
		"sh:targetClass" : { "@id" : "cas:Package" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"sh" : "http://www.w3.org/ns/shacl#"
		}
	},
	{
		"@id" : "cas:Property",
		"@type" : "owl:DatatypeProperty",
		"rdfs:label" : {
			"@language" : "en",
			"@value" : "Property"
		},
		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "A CASCaRA meta-model item used for properties (aka attributes)."
			},
			{
				"@language" : "de",
				"@value" : "Repräsentiert."
			}
			
		],
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas:Property_Shape",
		"@type" : "sh:PropertyShape",
		"sh:datatype" : { "@id" : "xsd:anyType" },
		"sh:path" : { "@id" : "cas:Property" },
		"@context" : {
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
