	dcterms:modified "2025-11-30T21:02:09Z"^^xsd:dateTime ;
	cas:color "#C0C0C0" ;
	cas:icon '''<?xml version="1.0" encoding="utf-8"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xml="http://www.w3.org/XML/1998/namespace" viewBox="0 0 24 24">
	<g class="fill">
		<rect x="3" y="3" width="5" height="2"/>
		<rect x="7" y="6.5" width="5" height="2"/>
		<rect x="7" y="15.5" width="5" height="2"/>
		<rect x="7" y="18.5" width="5" height="2"/>
		<rect x="12" y="3" width="5" height="2"/>
		<rect x="16" y="9.5" width="5" height="2"/>
		<rect x="16" y="12.5" width="5" height="2"/>
		<rect x="16" y="18.5" width="5" height="2"/>
	</g>
	<g class="outline">
		<rect x="7" y="9.5" width="5" height="2"/>
		<rect x="7" y="12.5" width="5" height="2"/>
		<rect x="16" y="6.5" width="5" height="2"/>
		<rect x="16" y="15.5" width="5" height="2"/>
		<polyline points="7,7.5 5.5,7.5 5.5,5"/>
		<polyline points="7,10.5 5.5,10.5 5.5,7.5"/>
		<polyline points="7,13.5 5.5,13.5 5.5,10.5"/>
		<polyline points="7,16.5 5.5,16.5 5.5,13.5"/>
		<polyline points="7,19.5 5.5,19.5 5.5,16.5"/>
		<polyline points="16,7.5 14.5,7.5 14.5,5"/>
		<polyline points="16,10.5 14.5,10.5 14.5,7.5"/>
		<polyline points="16,13.5 14.5,13.5 14.5,10.5"/>
		<polyline points="16,16.5 14.5,16.5 14.5,13.5"/>
		<polyline points="16,19.5 14.5,19.5 14.5,16.5"/>
	</g>
</svg>
''' ;
	rdfs:definedBy cas-ref:ISO-26580 ;
	skos:definition
		"Represents a configuration as a context for other elements to be valid. The datamodel allows selected elements to be related to a revision, i. e. mechanical components"@en ,
		"Repräsentiert eine Konfiguration als Kontext, in dem verknüpfte Elemente gültig sein sollen. Das Datenmodell sieht vor, ausgewählte Elemente mit einer Konfiguration zu verknüpfen, z. B. mechanische Komponenten."@de
		;
	.

