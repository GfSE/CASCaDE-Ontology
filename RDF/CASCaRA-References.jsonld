	{
		"@id" : "cas-ref:VDA-4951",
		"@type" : "cmns-doc:ReferenceDocument",
		"dc:title" : [
			{
				"@language" : "en",
				"@value" : "Datenfernübertragung von CAD/CAM Daten"
			},
			{
				"@language" : "de",
				"@value" : "The non-binding VDA Recommendation 4951 describes agreements regarding procedures, formats and contents of files, which standardize the exchange of CAD/CAM data and the associated administrative information and thus make it reliable and secure.  Due to the large number of topics in the field of CAD/CAM data exchange, the recommendation is divided into individual sub-documents, each of which is dedicated to one topic, but some of which also refer to or build on each other.  The numbering of the sub-documents does not indicate any context or a priority, it is simply historical."
			}
			
		],
		"@context" : {
			"cmns-doc" : "https://www.omg.org/spec/Commons/Documents/",
			"cas-ref" : "http://www.omg.org/spec/CASCaRA/references/",
