	a sh:NodeShape ;
	sh:property
		:description_Shape ,
		:endDateTime_Shape ,
		:identifier_Shape ,
		:number_Shape ,
		:startDateTime_Shape ,
		:title_Shape ,
		:type_Shape
		;
	sh:targetClass cas-ctx:Configuration ;
	.

