	dcterms:modified "2025-11-26T02:39:29Z"^^xsd:dateTime ;
	cas:color "#FF8000" ;
	cas:icon '''<?xml version="1.0" encoding="utf-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
	<g class="fill transparent outline">
		<path d="M 3 9.5 L 3 17.5 L 10 17.5 L 12 17.5 L 21 17.5 L 21 9.5 L 15 9.5 L 14 10.5 L 14 13.5 L 12 14.5 L 10 13.5 L 10 10.5 L 9 9.5 L 3 9.5 z "/>
	</g>
	<g class="outline">
		<line x1="12" y1="6" x2="12" y2="18"/>
		<path d="m 9,9.5 h 6"/>
	<path d="m 10,10.5 h 4"/>
	</g>
</svg>
''' ;
	rdfs:definedBy cas-ref:DIN-ISO-15786 ;
	skos:definition
		"A cylindrical or conical hole in a part, typically used as a mechanical interface to other mechanical components."@en ,
		"Ein zylindrisches oder konisches Loch in einem Teil. Repräsentiert typischerweise eine mechanische Schnittstelle zu anderen mechanischen Komponenten."@de
		;
	.

