					<tag xmi:id="EAID_0DAA5602_733C_4ff0_B9F6_ADE0D346D155" name="Category" value="DIN-EN-ISO" modelElement="EAID_B74095EA_5B17_4ac5_B3EF_2ED93966E6DD"/>
					<tag xmi:id="EAID_A627D129_243E_40c5_A645_717ED00F9A1E" name="Description" value="Eine geometrische Spezifikation gilt für ein einzelnes vollständiges Geometrieelement, sofern nicht ausdrücklich etwas anderes angegeben ist. Wenn das tolerierte Geometrieelement kein einzelnes vollständiges Geometrieelement ist, siehe 8.4.2, Abschnitt 9 " modelElement="EAID_B74095EA_5B17_4ac5_B3EF_2ED93966E6DD"/>
					<tag xmi:id="EAID_8FAE05ED_591B_450a_97B9_EE9D1F1F73C7" name="Type" value="Section" modelElement="EAID_B74095EA_5B17_4ac5_B3EF_2ED93966E6DD"/>
