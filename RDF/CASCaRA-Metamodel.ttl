	dcterms:title "CASCaRA Metamodel" ;
	owl:versionInfo "1.0" ;
	.

cas:Entity
  a owl:Class ;
  rdfs:label "Entity"@en ;
  skos:definition "A CASCaRA meta-model item used for entities."@en .

cas:Entity_Shape
  a sh:NodeShape ;
  sh:targetClass cas:Entity ;
  sh:property [
    sh:path rdfs:comment ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1
  ] .
  
cas:Package
  a owl:Class ;
  rdfs:subClassOf cas:Entity ;
  rdfs:label "Package"@en ;
  skos:definition "A CASCaRA meta-model item used for packages comprising entities, relationships and potentially nested packages."@en .

cas:Package_Shape
  a sh:NodeShape ;
  sh:targetClass cas:Package ;
  sh:property [
    sh:path rdfs:comment ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1
  ] .
  
cas:Property
  a owl:DatatypeProperty ;
  rdfs:label "Property"@en ;
  skos:definition "A CASCaRA meta-model item used for properties (aka attributes)."@en .

cas:Property_Shape
  a sh:PropertyShape ;
  sh:path cas:Property ;
  sh:datatype xsd:anyType .
  
cas:Relationship
  a owl:Class ;
  rdfs:label "Relationship"@en ;
  skos:definition "A CASCaRA meta-model item used for reified relationships (aka predicates)."@en .

cas:Relationship_Shape
  a sh:NodeShape ;
  sh:targetClass cas:Relationship ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path cas:linksSource ;
    sh:node cas:linksSource_Shape
  ] ;
  sh:property [
    sh:path cas:linksTarget ;
    sh:node cas:linksTarget_Shape
  ] .

cas:Link
  a owl:ObjectProperty ;
  rdfs:label "linked with"@en ;
  skos:definition "A PIG meta-model item connecting a reified relationship with its source or target. Also connects an organizer to a model element."@en ;
  rdfs:range [
    owl:unionOf (
      cas:Entity
      cas:Relationship
    )
  ] .

cas:linksSource
  a owl:ObjectProperty ;
  rdfs:subPropertyOf cas:Link ;
  rdfs:label "to source"@en ;
  skos:definition "Connects the source of a reified relationship."@en ;
  rdfs:range [
    owl:unionOf (
      cas:Entity
      cas:Relationship
    )
  ] .
  
cas:linksSource_Shape
  a sh:PropertyShape ;
  sh:path cas:linksSource ;
  sh:or (
    [ sh:class cas:Entity ]
    [ sh:class cas:Relationship ]
  ) .´

cas:linksTarget
  a owl:ObjectProperty ;
  rdfs:subPropertyOf cas:Link ;
  rdfs:label "to target"@en ;
  skos:definition "Connects the target of a reified relationship or an organizer."@en ;
  rdfs:range [
    owl:unionOf (
      cas:Entity
      cas:Relationship
    )
  ] .

cas:linksTarget_Shape
  a sh:PropertyShape ;
  sh:path cas:linksTarget ;
  sh:or (
    [ sh:class cas:Entity ]
    [ sh:class cas:Relationship ]
  ) .


cas:Link_Shape
  a sh:PropertyShape ;
  sh:path cas:Link ;
  sh:or (
    [ sh:class cas:Entity ]
    [ sh:class cas:Relationship ]
  ) .