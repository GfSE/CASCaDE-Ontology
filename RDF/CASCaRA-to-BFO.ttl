@prefix cas-arch: <http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/> .
@prefix cas-ctx:  <http://www.omg.org/spec/CASCaRA/ontology/ContextElements/> .
@prefix cas-ee:   <http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/ElectricElectronicDesign/> .
@prefix cas-fld:  <http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/Fluids/> .
@prefix cas-mech: <http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/MechanicalDesign/> .
@prefix cas-mnf:  <http://www.omg.org/spec/CASCaRA/ontology/ManufacturingSupplyChain/> .
@prefix cas-op:   <http://www.omg.org/spec/CASCaRA/ontology/Operation/> .
@prefix cas-org:  <http://www.omg.org/spec/CASCaRA/ontology/Organization/> .
@prefix cas-proc:<http://www.omg.org/spec/CASCaRA/ontology/ManufacturingSupplyChain/ManufacturingProcess/> .
@prefix cas-sw:   <http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SoftwareDesign/> .
@prefix cas-sys:  <http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SystemsDesign/> .
@prefix cas-val:  <http://www.omg.org/spec/CASCaRA/ontology/ProductValidation/> .
@prefix cas-ver:  <http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/> .

@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.omg.org/spec/CASCaRA/bfo/>
	a owl:Ontology ;
	rdfs:label "CASCaRA Mapping to Basic Formal Ontology" ;
	dcterms:abstract "The CASCaRA ontology provides a definition of data entities, attributes and relationships representing the Digital Thread.\\nNote that this version of the ontology is in development and may be subject to modifications without notice." ;
	dcterms:contributor
		"Tonelli, Cecilia, Collins Aerospace,
		"Kirsch, Michael, :em engineering methods AG"
		;
	dcterms:created "09.06.2026 02:57:04" ;
