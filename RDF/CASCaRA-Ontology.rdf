	<owl:Class rdf:about="&cas-ctx;Configuration">
		<rdfs:subClassOf rdf:resource="&cas;Entity"/>
		<rdfs:label xml:lang="en">Configuration</rdfs:label>
		<rdfs:label xml:lang="de">Konfiguration</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2025-11-30T21:02:09Z</dcterms:modified>
		<rdfs:definedBy rdf:resource="&cas-ref;ISO-26580"/>
		<skos:definition xml:lang="en">Represents a configuration as a context for other elements to be valid. The datamodel allows selected elements to be related to a revision, i. e. mechanical components</skos:definition>
		<skos:definition xml:lang="de">Repräsentiert eine Konfiguration als Kontext, in dem verknüpfte Elemente gültig sein sollen. Das Datenmodell sieht vor, ausgewählte Elemente mit einer Konfiguration zu verknüpfen, z. B. mechanische Komponenten.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas-ctx;Configuration_Shape">
		<sh:property rdf:resource="&dc;description_Shape"/>
		<sh:property rdf:resource="&dc;identifier_Shape"/>
		<sh:property rdf:resource="&dc;title_Shape"/>
		<sh:property rdf:resource="http://www.omg.org/spec/CASCaRA/ontology/endDateTime_Shape"/>
		<sh:property rdf:resource="http://www.omg.org/spec/CASCaRA/ontology/number_Shape"/>
		<sh:property rdf:resource="http://www.omg.org/spec/CASCaRA/ontology/startDateTime_Shape"/>
		<sh:property rdf:resource="http://www.omg.org/spec/CASCaRA/ontology/type_Shape"/>
		<sh:targetClass rdf:resource="&cas-ctx;Configuration"/>
	</sh:NodeShape>
	
