		<default:identifier>_17_0_3_1_60c0217_1554373947269_619833_17513</default:identifier>
		<default:number>2.1.1</default:number>
		<default:title>Head</default:title>
		<default:description>The Mars Rover shall have a head</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710152799440_775076_5744">
		<rdfs:label>2.1.1.1 Head Position</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710152799440_775076_5744</default:identifier>
		<default:number>2.1.1.1</default:number>
		<default:title>Head Position</default:title>
		<default:description>The Head of the Mars Rover shall be higher mounted than body, suspension and traction unit.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153330085_930613_5754">
		<rdfs:label>2.1.1.2 Head Function</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153330085_930613_5754</default:identifier>
		<default:number>2.1.1.2</default:number>
		<default:title>Head Function</default:title>
		<default:description>The Head of the Mars Rover shall carry sensors and a LED Display.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710146462874_714909_5562">
		<rdfs:label>2.1.2 Body</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710146462874_714909_5562</default:identifier>
		<default:number>2.1.2</default:number>
		<default:title>Body</default:title>
		<default:description>The Mars Rover shall have a body</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710146492047_939247_5565">
		<rdfs:label>2.1.3 Suspension</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710146492047_939247_5565</default:identifier>
		<default:number>2.1.3</default:number>
		<default:title>Suspension</default:title>
		<default:description>The Mars Rover shall have a suspension suspending the traction unit</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710146526694_117941_5568">
		<rdfs:label>2.1.4 Traction Unit</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710146526694_117941_5568</default:identifier>
		<default:number>2.1.4</default:number>
		<default:title>Traction Unit</default:title>
		<default:description>The Mars Rover shall have a traction unit providing traction to the ground</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373894872_990229_16028">
		<rdfs:label>2.2 Power Supply</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373894872_990229_16028</default:identifier>
		<default:number>2.2</default:number>
		<default:title>Power Supply</default:title>
		<default:description>The Mars Rover shall have a power supply.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947269_334692_17515">
		<rdfs:label>2.2.1 External Power Supply</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947269_334692_17515</default:identifier>
		<default:number>2.2.1</default:number>
		<default:title>External Power Supply</default:title>
		<default:description>The Mars Rover shall be operable with internal power supply only.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947269_839759_17516">
		<rdfs:label>2.2.2 Internal Power Supply</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947269_839759_17516</default:identifier>
		<default:number>2.2.2</default:number>
		<default:title>Internal Power Supply</default:title>
		<default:description>The Mars Rover shall have a power supply fulfilling all of the following conditions:
* it contains an energy storage system
* it contains an energy management system
* it contains a power distribution system</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373992768_924005_18953">
		<rdfs:label>2.2.2.1 Energy Storage</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373992768_924005_18953</default:identifier>
		<default:number>2.2.2.1</default:number>
		<default:title>Energy Storage</default:title>
		<default:description>The Mars Rover shall have means to re-charde its energy storage system.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373992768_101922_18958">
		<rdfs:label>2.2.2.2 Available Power</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373992768_101922_18958</default:identifier>
		<default:number>2.2.2.2</default:number>
		<default:title>Available Power</default:title>
		<default:description>The Mars Rover shall be operable for 4h under all of the following conditions:
* The energy storage is fully loaded at the beginning
* The operation requires less than or equal to 60% of the max energy in peak load
* the environmental conditions are mission normal</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947269_80329_17517">
		<rdfs:label>2.2.3 Energy Re-Charging</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947269_80329_17517</default:identifier>
		<default:number>2.2.3</default:number>
		<default:title>Energy Re-Charging</default:title>
		<default:description>The Mars Rover shall re-charge the energy storage from 10% to 80% in 4h under the following conditions:
* re-charging at mission normal conditions
* no energy consumption of the Mars Rover since the re-charging period</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373886850_739640_15912">
		<rdfs:label>2.2.5 Electrical Values</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373886850_739640_15912</default:identifier>
		<default:number>2.2.5</default:number>
		<default:title>Electrical Values</default:title>
		<default:description>The Mars Rover shall use 12 V DC voltage</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1555340930579_881851_34234">
		<rdfs:label>2.2.5.1 Motor Voltage</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1555340930579_881851_34234</default:identifier>
		<default:number>2.2.5.1</default:number>
		<default:title>Motor Voltage</default:title>
		<default:description>The Mars Rover shall have one main drive motor for each traction device fulfilling the following conditions:
* using 12 V voltage
* using not more than 30 A current</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2022x_8a9027b_1707924576905_883240_5487">
		<rdfs:label>2.2.5.2 Encoder Voltage</rdfs:label>
		<default:identifier>_2022x_8a9027b_1707924576905_883240_5487</default:identifier>
		<default:number>2.2.5.2</default:number>
		<default:title>Encoder Voltage</default:title>
		<default:description>The Mars Rover shall have an encoder powered by 5 V voltage.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373886850_551019_15911">
		<rdfs:label>2.2.4 Energy Management</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373886850_551019_15911</default:identifier>
		<default:number>2.2.4</default:number>
		<default:title>Energy Management</default:title>
		<default:description>The Mars Rover shall have an energy management fullfilling all of the following conditions:
* distributing the energy to all systems
* prioritizing the energy available for the different systems
* limiting energy to individual systems to prioritize individual systems
* managing energy that the Mars Rover can recharge by itself in a time period of less than 24 hours</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373894872_489031_16029">
		<rdfs:label>2.3 Motion</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373894872_489031_16029</default:identifier>
		<default:number>2.3</default:number>
		<default:title>Motion</default:title>
		<default:description>The Mars Rover shall be able to move by itself.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947238_635549_17411">
		<rdfs:label>2.3.2 Motion over Obstacles</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947238_635549_17411</default:identifier>
		<default:number>2.3.2</default:number>
		<default:title>Motion over Obstacles</default:title>
		<default:description>The Mars Rover shall be able to move by itself over obstacles which fullfill one of the following condition:
* the obstacle is max. 20 cm high
* the slope angle uphil is max. 30 degree
* the slope angle downhil is max. 30 degree
* the roll angle of the Mars Rover since moving over the obstacle never exceeds an angle of 30 degree</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2022x_8a9027b_1708424764583_139395_5943">
		<rdfs:label>2.3.2.1 Deformation of the bogie</rdfs:label>
		<default:identifier>_2022x_8a9027b_1708424764583_139395_5943</default:identifier>
		<default:number>2.3.2.1</default:number>
		<default:title>Deformation of the bogie</default:title>
		<default:description>The bogie of the suspension system shall not bend more than 5% since all motion events.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710147594026_511625_5572">
		<rdfs:label>2.3.2.2 Plastic deformation of the bogie</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710147594026_511625_5572</default:identifier>
		<default:number>2.3.2.2</default:number>
		<default:title>Plastic deformation of the bogie</default:title>
		<default:description>The bogie of the suspension system shall not deform plastically for bending less than or equal to 7%.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947238_606232_17414">
		<rdfs:label>2.3.4 Motion Ground Contact</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947238_606232_17414</default:identifier>
		<default:number>2.3.4</default:number>
		<default:title>Motion Ground Contact</default:title>
		<default:description>The Mars Rover shall produce a ground pressure of max. 20 kPa.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947253_22759_17417">
		<rdfs:label>2.3.1 Max Motion Speed</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947253_22759_17417</default:identifier>
		<default:number>2.3.1</default:number>
		<default:title>Max Motion Speed</default:title>
		<default:description>The Mars Rover shall be able to move by itself with a max. speed of 7 m/s.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373947253_787088_17420">
		<rdfs:label>2.3.3 Motion over slopes</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373947253_787088_17420</default:identifier>
		<default:number>2.3.3</default:number>
		<default:title>Motion over slopes</default:title>
		<default:description>The Mars Rover shall be able to move on slopes which fullfill the following condition:
* slope angle uphill max. 20 degree
* slope angle downhill max. 30 degree
* slope angle sidehill max 15 degree</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888774_76355_15935">
		<rdfs:label>2.3.5 Electric Motion Drive</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888774_76355_15935</default:identifier>
		<default:number>2.3.5</default:number>
		<default:title>Electric Motion Drive</default:title>
		<default:description>The Mars Rover shall have one left and one right traction device both driven by one electrical motor each.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888774_384276_15938">
		<rdfs:label>2.3.8 Motion Distance</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888774_384276_15938</default:identifier>
		<default:number>2.3.8</default:number>
		<default:title>Motion Distance</default:title>
		<default:description>The Mars Rover shall be able to move at least 100m per day on all slopes where it is able to move on.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888774_923366_15937">
		<rdfs:label>2.3.7 Min Motion Speed</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888774_923366_15937</default:identifier>
		<default:number>2.3.7</default:number>
		<default:title>Min Motion Speed</default:title>
		<default:description>The Mars Rover shall be able to move by itself with a min. speed of 1 m/min</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888774_941195_15936">
		<rdfs:label>2.3.6 Start Driving</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888774_941195_15936</default:identifier>
		<default:number>2.3.6</default:number>
		<default:title>Start Driving</default:title>
		<default:description>The Mars Rover shall start driving by itself on all slopes where it is able to move on.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1555336591336_85392_31015">
		<rdfs:label>2.3.9 Stopping</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1555336591336_85392_31015</default:identifier>
		<default:number>2.3.9</default:number>
		<default:title>Stopping</default:title>
		<default:description>The Mars Rover shall be able to stop moving by itself down to 0 m/s speed.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148366772_438416_5581">
		<rdfs:label>2.3.10 Hill Holding</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148366772_438416_5581</default:identifier>
		<default:number>2.3.10</default:number>
		<default:title>Hill Holding</default:title>
		<default:description>The Mars Rover shall maintain 0 m/s motion on all slopes it is able to move on.
</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148561688_473742_5584">
		<rdfs:label>2.3.11 Steering</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148561688_473742_5584</default:identifier>
		<default:number>2.3.11</default:number>
		<default:title>Steering</default:title>
		<default:description>The Mars Rover shall be able to change driving direction to the left and to the right.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148601847_750005_5587">
		<rdfs:label>2.3.12 Diving Direction</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148601847_750005_5587</default:identifier>
		<default:number>2.3.12</default:number>
		<default:title>Diving Direction</default:title>
		<default:description>The Mars Rover shall be able to drive forwards and backwards.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148650016_796202_5590">
		<rdfs:label>2.3.13 Navigate</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148650016_796202_5590</default:identifier>
		<default:number>2.3.13</default:number>
		<default:title>Navigate</default:title>
		<default:description>The Mars Rover shall be able to calculate a route between its actual position and a target position</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148712446_394547_5593">
		<rdfs:label>2.3.13.1 Detecting Obstacles</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148712446_394547_5593</default:identifier>
		<default:number>2.3.13.1</default:number>
		<default:title>Detecting Obstacles</default:title>
		<default:description>The Mars Rover shall be able to identify obstacles by itself</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148782585_264451_5596">
		<rdfs:label>2.3.13.2 Map Data</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148782585_264451_5596</default:identifier>
		<default:number>2.3.13.2</default:number>
		<default:title>Map Data</default:title>
		<default:description>The Mars Rover shall have map data stored enabling it to calculate a route between its actual position and a target position</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710148844988_144183_5599">
		<rdfs:label>2.3.13.3 Preventing Obstacles</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710148844988_144183_5599</default:identifier>
		<default:number>2.3.13.3</default:number>
		<default:title>Preventing Obstacles</default:title>
		<default:description>The Mars Rover shall prevent driving over obstacles if all of the following conditions are true:
* the obstacle exceeds the measures of an acceptable obstacle as required in 1.1.3.2
* a rout is available around the obstacle or rearwards to a position capable to reach the target without crossing the obstacle.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373894872_844710_16030">
		<rdfs:label>2.4 Remote Control</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373894872_844710_16030</default:identifier>
		<default:number>2.4</default:number>
		<default:title>Remote Control</default:title>
		<default:description>The Mars Rover shall be controllable remote.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888790_510287_15941">
		<rdfs:label>2.4.2 Remote Steering</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888790_510287_15941</default:identifier>
		<default:number>2.4.2</default:number>
		<default:title>Remote Steering</default:title>
		<default:description>The Mars Rover steering direction shall be controllable remote.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373888774_288492_15940">
		<rdfs:label>2.4.1 Remote Speed Control</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373888774_288492_15940</default:identifier>
		<default:number>2.4.1</default:number>
		<default:title>Remote Speed Control</default:title>
		<default:description>The Mars Rover speed shall be controllable remote.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710149292477_668117_5602">
		<rdfs:label>2.4.3 Remote Control Priority</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710149292477_668117_5602</default:identifier>
		<default:number>2.4.3</default:number>
		<default:title>Remote Control Priority</default:title>
		<default:description>The Mars Rover remote control shall be able to overrule the auto navigation function.</default:description>
		<default:type>MDReqIF_1712564283503_898570_59</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373894872_183392_16031">
		<rdfs:label>2.5 Optical Feedback</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373894872_183392_16031</default:identifier>
		<default:number>2.5</default:number>
		<default:title>Optical Feedback</default:title>
		<default:description>The Mars Rover shall provide optical information if it is operable or not.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373890795_302548_15964">
		<rdfs:label>2.5.1 LED</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373890795_302548_15964</default:identifier>
		<default:number>2.5.1</default:number>
		<default:title>LED</default:title>
		<default:description>The Mars Rover shall have a LED for optical information if it is operable or not.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373894872_124599_16032">
		<rdfs:label>2.6 Max Mass</rdfs:label>
		<default:identifier>_17_0_3_1_60c0217_1554373894872_124599_16032</default:identifier>
		<default:number>2.6</default:number>
		<default:title>Max Mass</default:title>
		<default:description>The Mars Rover shall have a total mass of not more than 12 kg</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153834097_967050_5805">
		<rdfs:label>2.6.1 Mars Rover Mass</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153834097_967050_5805</default:identifier>
		<default:number>2.6.1</default:number>
		<default:title>Mars Rover Mass</default:title>
		<default:description>The Mars Rover shall have a total mass of not more than 10 kg</default:description>
		<default:type>MDReqIF_1712564283503_898570_59</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153885017_514661_5808">
		<rdfs:label>2.6.2 Payload</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153885017_514661_5808</default:identifier>
		<default:number>2.6.2</default:number>
		<default:title>Payload</default:title>
		<default:description>The Mars Rover shall have a payload of 2 kg.</default:description>
		<default:type>MDReqIF_1712564283446_317325_10</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710152920321_382759_5749">
		<rdfs:label>2.7 Mars Rover Capabilities</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710152920321_382759_5749</default:identifier>
		<default:number>2.7</default:number>
		<default:title>Mars Rover Capabilities</default:title>
		<default:description>The Mars Rover shall be able to execute the following operations individually and not in combination:
* Moving on Mars surface
* Capturing optical information
* Capturing video information
* Capturing audio information
* Sampling of Probes of solid material of individual diameter not bigger than 20 mm
* Sampling of probes of fluid material in the range of ph-value 0 to 11
* Sampling of probes of gas of not more than 50 mm³ volume and pressure between 1 hPa up to 3.000 hPa
* Sampling of biological probes of not more than 50 mm³ volume and not more than 30 mm length in any direction</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153615080_304380_5787">
		<rdfs:label>2.7.1 Mars Rover Communication</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153615080_304380_5787</default:identifier>
		<default:number>2.7.1</default:number>
		<default:title>Mars Rover Communication</default:title>
		<default:description>The Mars Rover shall be able to communicate sampled information to the Mars station.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153678770_496381_5792">
		<rdfs:label>2.7.2 Information Storage</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153678770_496381_5792</default:identifier>
		<default:number>2.7.2</default:number>
		<default:title>Information Storage</default:title>
		<default:description>The Mars Rover shall be capable to store information up to 2 TB</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153727491_409919_5797">
		<rdfs:label>2.7.3 Sample Storage</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153727491_409919_5797</default:identifier>
		<default:number>2.7.3</default:number>
		<default:title>Sample Storage</default:title>
		<default:description>The Mars Rover shall be able to store probes up to 48 h long.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710153776399_96192_5800">
		<rdfs:label>2.7.4 Unloading</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710153776399_96192_5800</default:identifier>
		<default:number>2.7.4</default:number>
		<default:title>Unloading</default:title>
		<default:description>The Mars Rover shall be able to unload stored probes into the Mars Station.</default:description>
		<default:type>MDReqIF_1712564283461_752038_19</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710151635216_154098_5695">
		<rdfs:label>2.9 Operating on Mars</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710151635216_154098_5695</default:identifier>
		<default:number>2.9</default:number>
		<default:title>Operating on Mars</default:title>
		<default:description>The Mars Rover shall be able to operate on the planet Mars.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710151675649_994932_5700">
		<rdfs:label>2.9.1 Operating Atmosphere</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710151675649_994932_5700</default:identifier>
		<default:number>2.9.1</default:number>
		<default:title>Operating Atmosphere</default:title>
		<default:description>The Mars Rover shall be able to operate in Mars atmosphere for at least 25 years.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710151718558_644987_5705">
		<rdfs:label>2.9.2 Mars Gravity</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710151718558_644987_5705</default:identifier>
		<default:number>2.9.2</default:number>
		<default:title>Mars Gravity</default:title>
		<default:description>The Mars Rover shall be able to operate under Mars gravity of 3.71 m/s².</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710151896250_201297_5710">
		<rdfs:label>2.9.3 Mars Temperatures</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710151896250_201297_5710</default:identifier>
		<default:number>2.9.3</default:number>
		<default:title>Mars Temperatures</default:title>
		<default:description>The Mars Rover shall be able to operate in a temperature range from -80°C up to 80°C</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710152037892_253674_5713">
		<rdfs:label>2.9.4 Mars Radiation</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710152037892_253674_5713</default:identifier>
		<default:number>2.9.4</default:number>
		<default:title>Mars Radiation</default:title>
		<default:description>The Mars Rover shall be able to be fully operable under constant cosmic radiation of at least 250 mSv.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710150433825_282917_5653">
		<rdfs:label>2.8 Landing on Mars</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710150433825_282917_5653</default:identifier>
		<default:number>2.8</default:number>
		<default:title>Landing on Mars</default:title>
		<default:description>The Mars Rover shall be able to land on planet Mars.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710150476050_13127_5658">
		<rdfs:label>2.8.1 Landing Temperatures</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710150476050_13127_5658</default:identifier>
		<default:number>2.8.1</default:number>
		<default:title>Landing Temperatures</default:title>
		<default:description>The Mars Rover shall resist temperatures of not more than 100°C for not more than 7 minutes while staying full functional.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710150561344_954069_5661">
		<rdfs:label>2.8.2 Landing Deceleration</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710150561344_954069_5661</default:identifier>
		<default:number>2.8.2</default:number>
		<default:title>Landing Deceleration</default:title>
		<default:description>The Mars Rover shall be able to withstand landing deceleration as listed below:
* Deceleration from 20.000 km/h at Mars atmosphere entry to 1.500 km/h in 4 minutes.
* Deceleration from 1.500 km/s to 25 m/s in 3 minutes</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710150880576_958104_5666">
		<rdfs:label>2.8.3 Landing speed</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710150880576_958104_5666</default:identifier>
		<default:number>2.8.3</default:number>
		<default:title>Landing speed</default:title>
		<default:description>The Mars Rover shall be full operable after a landing on Mars with the following conditions beeing true:
* The vertical speed at ground contact is not higher than 1 m/s
* The horizontal speed at graund contact is not higher than 1 m/s</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement rdf:about="http://www.example.org/idrootx2x0/_2021x_2_8d501e7_1710151377993_602525_5676">
		<rdfs:label>2.8.4 Landing Orientation</rdfs:label>
		<default:identifier>_2021x_2_8d501e7_1710151377993_602525_5676</default:identifier>
		<default:number>2.8.4</default:number>
		<default:title>Landing Orientation</default:title>
		<default:description>The Mars Rover shall land on Mars with the traction units first contacting the ground.</default:description>
		<default:type>MDReqIF_1712564283513_737771_74</default:type>
		<default:type/>
	</arch:Requirement>
	<arch:Requirement_partOf_Requirement rdf:about="http://www.example.org/idrootx2x0/_17_0_3_1_60c0217_1554373817716_227628_13935_Requirement.partOf.Requirement__17_0_3_1_60c0217_1554373833970_540169_14529">
