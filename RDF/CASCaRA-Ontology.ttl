		;
	.

cas-ctx:Change_affects_BendingSpecification_Shape
	a sh:PropertyShape ;
	sh:path cas-ctx:Change_affects_BendingSpecification ;
	.

cas-ctx:Change_affects_BendingSpecification_Source
	rdfs:subPropertyOf cas:linksSource ;
	rdfs:domain cas-ctx:Change_affects_BendingSpecification ;
	rdfs:range cas-ctx:Change ;
	.

cas-ctx:Change_affects_BendingSpecification_Source_Shape
