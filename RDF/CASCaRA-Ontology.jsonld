		"skos:definition" : [
			{
				"@language" : "en",
				"@value" : "A compiled component of software to be used in a product, i. e. executable or library"
			},
			{
				"@language" : "de",
				"@value" : "Eine kompilierte Softwarekomponente, die in einem Produkt verwendet werden soll, d. h. eine ausführbare Datei oder Bibliothek"
			}
			
		],
