<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" internalLogLevel="Debug" internalLogFile="${basedir}/nlog-internal.log">
  <variable name="logDirectory" value="${environment:LOCALAPPDATA}\CascaraRdfValidator"/>
  <targets>
    <target name="file" xsi:type="File" fileName="${logDirectory}\CascaraRdfValidator.log" layout="${longdate}|${level}|${logger}|${message} ${exception:format=tostring}" encoding="utf-8"/>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="file"/>
  </rules>
</nlog>