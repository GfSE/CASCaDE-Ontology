cas-ctx:Variant
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Variant"@en ,
		"Variante"@de
		;
	dcterms:modified "2025-11-30T20:52:38Z"^^xsd:dateTime ;
	rdfs:definedBy cas-ref:ISO-26580 ;
	skos:definition
		"Represents a variant as a context for other elements to be valid. The datamodel allows selected elements to be related to a variant, i. e. mechanical components"@en ,
		"Repräsentiert eine Variante als Kontext, in dem verknüpfte Elemente gültig sein sollen. Das Datenmodell sieht vor, ausgewählte Elemente mit einer Variante zu verknüpfen, z. B. mechanische Komponenten."@de
		;
	.

