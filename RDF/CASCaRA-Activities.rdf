		<cas:uses rdf:resource="&proc;JoiningProcess"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&ver;VerificationCharacteristic"/>
		<cas:uses rdf:resource="&ver;VerificationPlan"/>
		<cas:uses rdf:resource="&ver;VerificationResource"/>
		<skos:definition xml:lang="en">Includes the inspection of single parts, components or products during or after the manufacturing process, as well as the documentation of inspection results.</skos:definition>
	</owl:Class>
	
