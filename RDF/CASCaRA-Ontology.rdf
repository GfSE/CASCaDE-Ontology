		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition xml:lang="de">Eindeutiger Identifikator des Elements</skos:definition>
		<skos:definition xml:lang="en">Unambiguous identifier of the element</skos:definition>
	</owl:DatatypeProperty>
	
	<sh:PropertyShape rdf:about="&dc;identifier_Shape">
		<sh:datatype rdf:resource="&xsd;string"/>
		<sh:path rdf:resource="&dc;identifier"/>
	</sh:PropertyShape>
	
	<owl:DatatypeProperty rdf:about="&dc;title">
		<rdfs:subPropertyOf rdf:resource="&cas;Property"/>
		<rdfs:label xml:lang="de">Titel</rdfs:label>
