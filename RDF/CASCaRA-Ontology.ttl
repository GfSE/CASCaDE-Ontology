cas-sys:Deviation
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Abweichung"@de ,
		"Deviation"@en
		;
	dcterms:modified "2026-05-31T07:59:01Z"^^xsd:dateTime ;
	rdfs:definedBy
		cas-ref:ARP4754B ,
		cas-ref:ARP4761A ,
		cas-ref:DIN-EN-61508-1 ,
		cas-ref:ISO-21448 ,
		cas-ref:ISO-26262-1 ,
		cas-ref:ISO-IEC-20246
		;
	skos:definition
		"Represents a system, product or component deviation. A deviation affects a function. Deviations are typically managed in an FMEA."@en ,
		"Repräsentiert eine Abweichung eines Systems, Produkts oder einer Komponente. Eine Abweichung beeinträchtigt eine Funktion. Abweichungen werden typischerweise in einer FMEA verwaltet."@de
		;
	.

