	{
		"@id" : "cas-act:ConceptDefinition",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Entity" },
		"rdfs:label" : [
			{
				"@language" : "en",
				"@value" : "Concept definition"
			},
			{
				"@language" : "de",
				"@value" : "Konzeptdefinition"
			}
			
		],
		"dcterms:modified" : {
			"@type" : "xsd:dateTime",
			"@value" : "2022-02-18T11:17:54Z"
		},
		"skos:definition" : {
			"@language" : "en",
			"@value" : "In conceptual design, new products or systems are defined through requirements and specified through a functional structure in mechanical, electrics/electronics, and software domains. A logical structure specifies the future product architecture in order to implement the specified functions.\u000d\u000aBesides new products, existing products may be changed or modified significantly to better comply with customer needs, or to attract new customers. Eventually, the product may be changed or adopted to comply to new standards, regulations or laws.\u000d\u000aConceptual design is usually performed at a high abstraction level and low level of detail, using parameter studies, system models, and rough geometry, if any.\u000d\u000aFor the Digital Data Package, model-based methods and data for product conceptual design are assumed."
		},
		"@context" : {
			"cas-act" : "http://www.omg.org/spec/CASCaRA/activities/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"dcterms" : "http://purl.org/dc/terms/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#"
		}
	},
	{
		"@id" : "cas-act:LongTermArchiving",
		"@type" : "owl:Class",
		"rdfs:subClassOf" : { "@id" : "cas:Activity" },
		"rdfs:label" : [
			{
				"@language" : "de",
				"@value" : "Langzeitarchivierung"
			},
			{
				"@language" : "en",
				"@value" : "Long-Term Archiving"
			}
			
		],
		"cas:uses" : [
			{ "@id" : "cas-proc:JoiningProcess" },
			{ "@id" : "cas-arch:Function" },
			{ "@id" : "cas-arch:StakeholderRequirement" },
			{ "@id" : "cas-arch:SystemRequirement" },
			{ "@id" : "cas-mech:Body" },
			{ "@id" : "cas-mech:JoiningElement" },
			{ "@id" : "cas-mech:KinematicJoint" },
			{ "@id" : "cas-mech:KinematicMechanism" },
			{ "@id" : "cas-mech:Material" },
			{ "@id" : "cas-mech:MechanicalComponent" },
			{ "@id" : "cas-mech:ModelAnnotation" },
			{ "@id" : "cas-sys:ComponentConnection" },
			{ "@id" : "cas-sys:ComponentInterface" },
			{ "@id" : "cas-sys:ComponentState" },
			{ "@id" : "cas-sys:Deviation" },
			{ "@id" : "cas-sys:SystemComponent" },
			{ "@id" : "cas-val:Displacement" },
			{ "@id" : "cas-val:ValidationResult" },
			{ "@id" : "cas-val:ValidationRun" },
			{ "@id" : "http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationResult" },
			{ "@id" : "http://www.omg.org/spec/CASCaRA/ontology/ProductVerification/VerificationRun" }
			
		],
		"skos:definition" : {
			"@language" : "en",
			"@value" : "For long-term archiving, all product information must be configured and stored in a retrievable way. Product information includes domain-specifc models, relations between models and model entities, and meta-data about the documents and models."
		},
		"@context" : {
			"cas-val" : "http://www.omg.org/spec/CASCaRA/ontology/ProductValidation/",
			"cas-proc" : "http://www.omg.org/spec/CASCaRA/ontology/ManufacturingSupplyChain/ManufacturingProcess/",
			"cas-act" : "http://www.omg.org/spec/CASCaRA/activities/",
			"cas" : "http://www.omg.org/spec/CASCaRA/metamodel/",
			"rdf" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"owl" : "http://www.w3.org/2002/07/owl#",
			"cas-arch" : "http://www.omg.org/spec/CASCaRA/ontology/ProductArchitecture/",
			"skos" : "http://www.w3.org/2004/02/skos/core#",
			"rdfs" : "http://www.w3.org/2000/01/rdf-schema#",
			"cas-sys" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/SystemsDesign/",
			"cas-mech" : "http://www.omg.org/spec/CASCaRA/ontology/ProductDesign/MechanicalDesign/"
		}
	},
