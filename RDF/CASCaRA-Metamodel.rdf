		<dcterms:title>CASCaRA Metamodel &amp; Semantic Infrastructure</dcterms:title>
		<owl:versionInfo>1.0</owl:versionInfo>
	</owl:Ontology>
	
	<owl:Class rdf:about="&cas;Activity">
		<rdfs:subClassOf rdf:resource="&cas;Entity"/>
		<rdfs:label xml:lang="en">Activity</rdfs:label>
		<rdfs:label xml:lang="de">Prozessschritt</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA activity that uses CASCaRA entities and provides CASCaRA entities as result.</skos:definition>
		<skos:definition xml:lang="de">Ein CASCaRA-Prozessschritt, der CASCaRA-Entities verwendet und CASCaRA-Entities als Ergebnis bereitstellt.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Activity_Shape">
		<sh:property rdf:resource="&cas;provides_Shape"/>
		<sh:property rdf:resource="&cas;uses_Shape"/>
		<sh:targetClass rdf:resource="&cas;Activity"/>
	</sh:NodeShape>
	
	<owl:Class rdf:about="&cas;Entity">
		<rdfs:label xml:lang="de">Element</rdfs:label>
		<rdfs:label xml:lang="en">Entity</rdfs:label>
		<skos:definition xml:lang="en">Represents an entity as part of the CASCaRA semantic infrastructure.</skos:definition>
		<skos:definition xml:lang="de">Repräsentiert ein Element als Bestandteil der CASCaRA semantischen Infrastruktur.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Entity_Shape">
		<sh:targetClass rdf:resource="&cas;Entity"/>
	</sh:NodeShape>
	
	<owl:ObjectProperty rdf:about="&cas;Link">
		<rdfs:label xml:lang="en">linked to</rdfs:label>
		<rdfs:label xml:lang="de">verknüpft mit</rdfs:label>
		<rdfs:domain rdf:resource="&cas;Relationship"/>
		<rdfs:range rdf:resource="&cas;Entity"/>
		<skos:definition xml:lang="en">Represents a link as part of the CASCaRA semantic infrastructure.</skos:definition>
		<skos:definition xml:lang="de">Repräsentiert eine Verknüpfung als Bestandteil der CASCaRA semantischen Infrastuktur.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;Link_Shape">
		<sh:path rdf:resource="&cas;Link"/>
	</sh:PropertyShape>
	
	<owl:Class rdf:about="&cas;Organizer">
		<rdfs:subClassOf rdf:resource="&cas;Entity"/>
		<rdfs:label xml:lang="de">Hierarchieelement</rdfs:label>
		<rdfs:label xml:lang="en">Organizer</rdfs:label>
		<skos:definition xml:lang="en">An element organizing model elements. An example is a list of requirements or a diagram using a certain notation.</skos:definition>
		<skos:definition xml:lang="de">Ein Element, das andere Elemente organisiert. Beispielsweise eine Liste von Anforderungen oder ein Diagramm mit einer bestimmten Notation.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Organizer_Shape">
		<sh:or rdf:nodeID="blank3"/>
		<sh:property rdf:resource="&cas;Category_Shape"/>
		<sh:targetClass rdf:resource="&cas;Organizer"/>
	</sh:NodeShape>
	
	<owl:Class rdf:about="&cas;Outline">
		<rdfs:subClassOf rdf:resource="&cas;Organizer"/>
		<rdfs:label xml:lang="de">Gliederung</rdfs:label>
		<rdfs:label xml:lang="en">Outline</rdfs:label>
		<skos:definition xml:lang="en">A subclass of CASCaRA organizer comprising all information items of a human-readable document. As usual, the outline is hierarchically organized.</skos:definition>
		<skos:definition xml:lang="de">Eine Subklasse des CASCaRA-Organizers, die alle Informationselemente eines menschenlesbaren Dokuments zusammenfasst.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Outline_Shape">
		<sh:or rdf:nodeID="blank4"/>
		<sh:targetClass rdf:resource="&cas;Outline"/>
	</sh:NodeShape>
	
	<owl:Class rdf:about="&cas;Package">
		<rdfs:subClassOf rdf:resource="&cas;Entity"/>
		<rdfs:label xml:lang="en">Package</rdfs:label>
		<rdfs:label xml:lang="de">Paket</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA package that includes all CASCaRA entities and relationships selected for a defined purpose.</skos:definition>
		<skos:definition xml:lang="de">Ein CASCaRA-Paket, das alle CASCaRA-Entities und -Relationen für einen bestimmten Zweck umfasst.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Package_Shape">
		<sh:targetClass rdf:resource="&cas;Package"/>
	</sh:NodeShape>
	
	<owl:DatatypeProperty rdf:about="&cas;Property">
		<rdfs:label xml:lang="en">Property</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA meta-model item used for properties (aka attributes).</skos:definition>
		<skos:definition xml:lang="de">Repräsentiert.</skos:definition>
	</owl:DatatypeProperty>
	
	<sh:PropertyShape rdf:about="&cas;Property_Shape">
		<sh:datatype rdf:resource="&xsd;anyType"/>
		<sh:path rdf:resource="&cas;Property"/>
	</sh:PropertyShape>
	
	<owl:Class rdf:about="&cas;Relationship">
		<rdfs:label xml:lang="de">Relation</rdfs:label>
		<rdfs:label xml:lang="en">Relationship</rdfs:label>
		<skos:definition xml:lang="en">Represents a Relationship between two Entities as part of the CASCaRA semantic infrastructure.</skos:definition>
		<skos:definition xml:lang="de">Repräsentiert eine Relation zwischen zwei Entitäten als Bestandteil der CASCaRA semantischen Infrastruktur.</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas;Relationship_Shape">
		<sh:property rdf:resource="&cas;linksSource_Shape"/>
		<sh:property rdf:resource="&cas;linksTarget_Shape"/>
		<sh:targetClass rdf:resource="&cas;Relationship"/>
	</sh:NodeShape>
	
	<owl:ObjectProperty rdf:about="&cas;linksSource">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">to source</rdfs:label>
		<rdfs:label xml:lang="de">zu Quelle</rdfs:label>
		<rdfs:domain rdf:resource="&cas;Relationship"/>
		<rdfs:range rdf:resource="&cas;Entity"/>
		<skos:definition xml:lang="en">Connects the source entity of a reified relationship.</skos:definition>
		<skos:definition xml:lang="de">Verbindet das Quellobjekt einer reifizierten Relation.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;linksSource_Shape">
		<sh:class rdf:resource="&cas;Entity"/>
		<sh:path rdf:resource="&cas;linksSource"/>
	</sh:PropertyShape>
	
	<owl:ObjectProperty rdf:about="&cas;linksTarget">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">to target</rdfs:label>
		<rdfs:label xml:lang="de">zu Ziel</rdfs:label>
		<rdfs:domain rdf:resource="&cas;Relationship"/>
		<rdfs:range rdf:resource="&cas;Entity"/>
		<skos:definition xml:lang="en">Connects the target entity of a reified relationship.</skos:definition>
		<skos:definition xml:lang="de">Verbindet das Zielobjekt einer reifizierten Relation.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;linksTarget_Shape">
		<sh:class rdf:resource="&cas;Entity"/>
		<sh:path rdf:resource="&cas;linksTarget"/>
	</sh:PropertyShape>
	
	<owl:ObjectProperty rdf:about="&cas;provides">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">provides</rdfs:label>
		<rdfs:label xml:lang="de">stellt bereit</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA Link that relates to CASCaRA entities provided by this activity.</skos:definition>
		<skos:definition xml:lang="de">CASCaRA-Link, der auf CASCaRA-Entities verweist, welche von diesem Prozessschritt bereitgestellt werden.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;provides_Shape">
		<sh:class rdf:resource="&cas;Entity"/>
		<sh:path rdf:resource="&cas;provides"/>
	</sh:PropertyShape>
	
	<owl:ObjectProperty rdf:about="&cas;uses">
		<rdfs:subPropertyOf rdf:resource="&cas;Link"/>
		<rdfs:label xml:lang="en">uses</rdfs:label>
		<rdfs:label xml:lang="de">verwendet</rdfs:label>
		<skos:definition xml:lang="en">A CASCaRA Link that relates to CASCaRA entities used by this activity.</skos:definition>
		<skos:definition xml:lang="de">CASCaRA-Link, der auf CASCaRA-Entities verweist, welche in diesem Prozessschritt verwendet werden.</skos:definition>
	</owl:ObjectProperty>
	
	<sh:PropertyShape rdf:about="&cas;uses_Shape">
		<sh:class rdf:resource="&cas;Entity"/>
		<sh:path rdf:resource="&cas;uses"/>
	</sh:PropertyShape>
	
	<rdf:Description rdf:nodeID="blank1">
		<rdf:first rdf:nodeID="blank5"/>
		<rdf:rest rdf:resource="&rdf;nil"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank2">
		<rdf:first rdf:nodeID="blank6"/>
		<rdf:rest rdf:resource="&rdf;nil"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank3">
		<rdf:first rdf:nodeID="blank7"/>
		<rdf:rest rdf:nodeID="blank1"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank4">
		<rdf:first rdf:nodeID="blank8"/>
		<rdf:rest rdf:nodeID="blank2"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank5">
		<sh:minCount rdf:datatype="&xsd;integer">1</sh:minCount>
		<sh:path rdf:resource="&rdfs;comment"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank6">
		<sh:minCount rdf:datatype="&xsd;integer">1</sh:minCount>
		<sh:path rdf:resource="&rdfs;comment"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank7">
		<sh:minCount rdf:datatype="&xsd;integer">1</sh:minCount>
		<sh:path rdf:resource="&rdfs;label"/>
	</rdf:Description>
	
	<rdf:Description rdf:nodeID="blank8">
		<sh:minCount rdf:datatype="&xsd;integer">1</sh:minCount>
		<sh:path rdf:resource="&rdfs;label"/>
	</rdf:Description>

</rdf:RDF>