		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&mech;ModelView"/>
		<cas:uses rdf:resource="&mech;SurfaceTexture"/>
		<skos:definition xml:lang="en">Assembly of components or products from single parts or sub-components according to a production plan, using all kinds of joinig and bonding.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&man;QualityInspection">
