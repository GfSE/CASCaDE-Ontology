                                                                 a cas-arch:Requirement.
f36d94e1ce5e4307acf8e9d7:Requirement_2-3-3_Motion-over-slopes dc:description "The Mars Rover shall be able to move on slopes which fullfill the following condition:* slope angle uphill max. 20 degree* slope angle downhill max. 30 degree* slope angle sidehill max 15 degree";
                                                              dc:identifier "_17_0_3_1_60c0217_1554373947253_787088_17420";
