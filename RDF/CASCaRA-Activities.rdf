		<skos:definition xml:lang="en">Testing preparation includes the definition of product requirements and functions to be validated, the specification, design and manufacturing of samples, prototypes and test rigs.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&pro;DefinitionProductAssetInstanceConfigurabilitySpace">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Definition product asset instance configurability space</rdfs:label>
