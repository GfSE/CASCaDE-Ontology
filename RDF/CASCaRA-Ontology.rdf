		<rdfs:range rdf:resource="&cas-sys;SystemComponent"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="&cas-sys;SystemComponent_fulfils_Requirement_Source_Shape">
		<sh:path rdf:resource="&cas-sys;SystemComponent_fulfils_Requirement"/>
		<sh:property rdf:resource="&cas-sys;SystemComponent_fulfils_Requirement_Source"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="&cas-sys;SystemComponent_fulfils_Requirement_Target">
		<rdfs:subPropertyOf rdf:resource="&cas;linksTarget"/>
		<rdfs:domain rdf:resource="&cas-sys;SystemComponent_fulfils_Requirement"/>
		<rdfs:range rdf:resource="&cas-arch;Requirement"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="&cas-sys;SystemComponent_fulfils_Requirement_Target_Shape">
		<sh:path rdf:resource="&cas-sys;SystemComponent_fulfils_Requirement"/>
