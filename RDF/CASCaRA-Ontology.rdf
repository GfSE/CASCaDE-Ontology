		<rdfs:label xml:lang="de">Beschreibung</rdfs:label>
		<rdfs:label xml:lang="en">Description</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2026-06-30T00:23:38Z</dcterms:modified>
		<rdfs:range rdf:resource="&xsd;string"/>
		<skos:definition xml:lang="de">Beschreibung des Elements</skos:definition>
		<skos:definition xml:lang="en">Description of the element</skos:definition>
	</owl:DatatypeProperty>
	
	<sh:PropertyShape rdf:about="&dc;description_Shape">
