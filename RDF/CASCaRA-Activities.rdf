		<cas:uses rdf:resource="&mech;Thread"/>
		<skos:definition xml:lang="en">Includes the calculation of product cost using relevant information from product and production specifications, including dimensions, material, mass, geometric &amp; topological complexity, surface finish including paint or coatings.</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductionDevelopment/InspectionPlanning">
		<rdfs:subClassOf rdf:resource="&cas;Activity"/>
		<rdfs:label xml:lang="en">Inspection Planning</rdfs:label>
		<rdfs:label xml:lang="de">Prüfplanung</rdfs:label>
		<cas:provides rdf:resource="&ver;VerificationCharacteristic"/>
		<cas:provides rdf:resource="&ver;VerificationPlan"/>
		<cas:provides rdf:resource="&ver;VerificationResource"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicComponent"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicConnection"/>
		<cas:uses rdf:resource="&ee;ElectricElectronicPort"/>
		<cas:uses rdf:resource="&mech;BendingSpecification"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;Cleanliness"/>
		<cas:uses rdf:resource="&mech;Datum"/>
		<cas:uses rdf:resource="&mech;DimensionalSize"/>
		<cas:uses rdf:resource="&mech;Gearing"/>
		<cas:uses rdf:resource="&mech;GeometricTolerance"/>
		<cas:uses rdf:resource="&mech;HeatTreatedArea"/>
		<cas:uses rdf:resource="&mech;Hole"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;KinematicJoint"/>
		<cas:uses rdf:resource="&mech;KinematicMechanism"/>
		<cas:uses rdf:resource="&mech;MarkingLabeling"/>
		<cas:uses rdf:resource="&mech;Material"/>
