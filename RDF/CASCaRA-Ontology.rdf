		<rdfs:definedBy rdf:resource="&cas-ref;DO-297"/>
		<rdfs:definedBy rdf:resource="&cas-ref;ISO-IEC-20246"/>
		<rdfs:definedBy rdf:resource="&cas-ref;ISO-IEC-IEEE-29119-1"/>
		<skos:definition xml:lang="en">A compiled component of software to be used in a product, i. e. executable or library</skos:definition>
		<skos:definition xml:lang="de">Eine kompilierte Softwarekomponente, die in einem Produkt verwendet werden soll, d. h. eine ausführbare Datei oder Bibliothek</skos:definition>
	</owl:Class>
	
	<sh:NodeShape rdf:about="&cas-sw;SoftwareComponent_Shape">
		<sh:targetClass rdf:resource="&cas-sw;SoftwareComponent"/>
	</sh:NodeShape>
	
