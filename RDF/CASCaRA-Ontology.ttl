cas-ctx:Configuration
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Configuration"@en ,
		"Konfiguration"@de
		;
	dcterms:modified "2025-11-30T21:02:09Z"^^xsd:dateTime ;
	rdfs:definedBy cas-ref:ISO-26580 ;
	skos:definition
		"Represents a configuration as a context for other elements to be valid. The datamodel allows selected elements to be related to a revision, i. e. mechanical components"@en ,
		"Repräsentiert eine Konfiguration als Kontext, in dem verknüpfte Elemente gültig sein sollen. Das Datenmodell sieht vor, ausgewählte Elemente mit einer Konfiguration zu verknüpfen, z. B. mechanische Komponenten."@de
		;
	.

cas-ctx:Configuration_Shape
	a sh:NodeShape ;
	sh:property
		dc:description_Shape ,
		dc:identifier_Shape ,
		dc:title_Shape ,
		:endDateTime_Shape ,
		:number_Shape ,
		:startDateTime_Shape ,
		:type_Shape
		;
	sh:targetClass cas-ctx:Configuration ;
	.

