			"@value" : "<?xml version=\"1.0\" encoding=\"utf-8\"?>\u000d\u000a<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u000d\u000a\u0009<g class=\"fill transparent outline\">\u000d\u000a\u0009\u0009<path d=\"M 3 9.5 L 3 17.5 L 10 17.5 L 12 17.5 L 21 17.5 L 21 9.5 L 15 9.5 L 14 10.5 L 14 13.5 L 12 14.5 L 10 13.5 L 10 10.5 L 9 9.5 L 3 9.5 z \"/>\u000d\u000a\u0009</g>\u000d\u000a\u0009<g class=\"outline\">\u000d\u000a\u0009\u0009<line x1=\"12\" y1=\"6\" x2=\"12\" y2=\"18\"/>\u000d\u000a\u0009\u0009<path d=\"m 9,9.5 h 6\"/>\u000d\u000a\u0009<path d=\"m 10,10.5 h 4\"/>\u000d\u000a\u0009</g>\u000d\u000a</svg>\u000d\u000a"
