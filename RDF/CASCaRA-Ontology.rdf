	<owl:Class rdf:about="&cas-sw;SoftwareClass">
		<rdfs:subClassOf rdf:resource="&cas-sys;SystemComponent"/>
		<rdfs:label xml:lang="en">Software Class</rdfs:label>
		<rdfs:label xml:lang="de">Software-Klasse</rdfs:label>
		<dcterms:modified rdf:datatype="&xsd;dateTime">2025-12-01T01:45:52Z</dcterms:modified>
		<rdfs:definedBy rdf:resource="&cas-ref;ISO-IEC-19513"/>
		<rdfs:definedBy rdf:resource="&cas-ref;ISO-IEC-20246"/>
		<skos:definition xml:lang="en">A class in source code that represents a logical collection data and functions</skos:definition>
		<skos:definition xml:lang="de">Eine Klasse im Quellcode, die eine logische Sammlung von Daten und Funktionen darstellt</skos:definition>
