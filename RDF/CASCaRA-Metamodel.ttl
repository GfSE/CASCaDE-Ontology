	dcterms:title "CASCaRA Metamodel" ;
	owl:versionInfo "1.0" ;
	.

cas:Activity
	a owl:Class ;
	rdfs:label
		"Activity"@en ,
		"Prozessschritt"@de
		;
	skos:definition
		"A CASCaRA activity that relates to data entities delivered or required by this use-case."@en ,
		"Ein CASCaRA-Prozess, der sich auf Entities bezieht, die im Rahmen dieses Anwendungsfalls bereitgestellt oder benötigt werden."@de
		;
	.

cas:Activity_Shape
	a sh:NodeShape ;
	sh:property
		_:blank19 ,
		_:blank20
		;
	sh:targetClass cas:Activity ;
	.

cas:Entity
	a owl:Class ;
	rdfs:label "Entity"@en ;
	skos:definition "A CASCaRA meta-model item used for entities."@en ;
	.

cas:Entity_Shape
	a sh:NodeShape ;
	sh:property
		_:blank24 ,
		_:blank26
		;
	sh:targetClass cas:Entity ;
	.

cas:Link
	a owl:ObjectProperty ;
	rdfs:label "linked with"@en ;
	rdfs:range _:blank13 ;
	skos:definition "A PIG meta-model item connecting a reified relationship with its source or target. Also connects an organizer to a model element."@en ;
	.

cas:Link_Shape
	a sh:PropertyShape ;
	sh:or _:blank09 ;
	sh:path cas:Link ;
	.

cas:Package
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Package"@en ,
		"Paket"@de
		;
	skos:definition "A CASCaRA meta-model item used for packages comprising entities, relationships and potentially nested packages."@en ;
	.

cas:Package_Shape
	a sh:NodeShape ;
	sh:property
		_:blank25 ,
		_:blank27
		;
	sh:targetClass cas:Package ;
	.

cas:Property
	a owl:DatatypeProperty ;
	rdfs:label "Property"@en ;
	skos:definition "A CASCaRA meta-model item used for properties (aka attributes)."@en ;
	.

cas:Property_Shape
	a sh:PropertyShape ;
	sh:datatype xsd:anyType ;
	sh:path cas:Property ;
	.

cas:Provided
	a owl:ObjectProperty ;
	rdfs:label
		"Bereitgestellt"@de ,
		"Provided"@en
		;
	rdfs:domain cas:Activity ;
	rdfs:range cas:Entity ;
	.

cas:Relationship
	a owl:Class ;
	rdfs:label "Relationship"@en ;
	skos:definition "A CASCaRA meta-model item used for reified relationships (aka predicates)."@en ;
	.

cas:Relationship_Shape
	a sh:NodeShape ;
	sh:property
		_:blank28 ,
		_:blank29 ,
		_:blank30
		;
	sh:targetClass cas:Relationship ;
	.

cas:Used
	a owl:ObjectProperty ;
	rdfs:label
		"Used"@en ,
		"Verwendet"@de
		;
	rdfs:domain cas:Activity ;
	rdfs:range cas:Entity ;
	.

cas:linksSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label "to source"@en ;
	rdfs:range _:blank14 ;
	skos:definition "Connects the source of a reified relationship."@en ;
	.

cas:linksSource_Shape
	a sh:PropertyShape ;
	sh:or _:blank07 ;
	sh:path cas:linksSource ;
	.

cas:linksTarget
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cas:Link ;
	rdfs:label "to target"@en ;
	rdfs:range _:blank15 ;
	skos:definition "Connects the target of a reified relationship or an organizer."@en ;
	.

cas:linksTarget_Shape
	a sh:PropertyShape ;
	sh:or _:blank08 ;
	sh:path cas:linksTarget ;
	.

_:blank01
	rdf:first cas:Entity ;
	rdf:rest _:blank04 ;
	.

_:blank02
	rdf:first cas:Entity ;
	rdf:rest _:blank05 ;
	.

_:blank03
	rdf:first cas:Entity ;
	rdf:rest _:blank06 ;
	.

_:blank04
	rdf:first cas:Relationship ;
	rdf:rest rdf:nil ;
	.

_:blank05
	rdf:first cas:Relationship ;
	rdf:rest rdf:nil ;
	.

_:blank06
	rdf:first cas:Relationship ;
	rdf:rest rdf:nil ;
	.

_:blank07
	rdf:first _:blank16 ;
	rdf:rest _:blank10 ;
	.

_:blank08
	rdf:first _:blank17 ;
	rdf:rest _:blank11 ;
	.

_:blank09
	rdf:first _:blank18 ;
	rdf:rest _:blank12 ;
	.

_:blank10
	rdf:first _:blank21 ;
	rdf:rest rdf:nil ;
	.

_:blank11
	rdf:first _:blank22 ;
	rdf:rest rdf:nil ;
	.

_:blank12
	rdf:first _:blank23 ;
	rdf:rest rdf:nil ;
	.

_:blank13
	owl:unionOf _:blank01 ;
	.

_:blank14
	owl:unionOf _:blank02 ;
	.

_:blank15
	owl:unionOf _:blank03 ;
	.

_:blank16
	sh:class cas:Entity ;
	.

_:blank17
	sh:class cas:Entity ;
	.

_:blank18
	sh:class cas:Entity ;
	.

_:blank19
	sh:class cas:Entity ;
	sh:path cas:Provided ;
	.

_:blank20
	sh:class cas:Entity ;
	sh:path cas:Used ;
	.

_:blank21
	sh:class cas:Relationship ;
	.

_:blank22
	sh:class cas:Relationship ;
	.

_:blank23
	sh:class cas:Relationship ;
	.

_:blank24
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:comment ;
	.

_:blank25
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:comment ;
	.

_:blank26
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:label ;
	.

_:blank27
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:label ;
	.

_:blank28
	sh:minCount "1"^^xsd:integer ;
	sh:path rdfs:label ;
	.

_:blank29
	sh:node cas:linksSource_Shape ;
	sh:path cas:linksSource ;
	.

_:blank30
	sh:node cas:linksTarget_Shape ;
	sh:path cas:linksTarget ;
	.

