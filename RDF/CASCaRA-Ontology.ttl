:ContextElements
	a owl:Class ;
	rdfs:subClassOf cas:EntityGroup ;
	rdfs:label
		"Context Elements"@en ,
		"Kontextelemente"@de
		;
	dcterms:hasPart
		cas-ctx:Change ,
		cas-ctx:Configuration ,
		cas-ctx:Reference ,
		cas-ctx:Variant
		;
	skos:definition
		"Includes entities that provide context in which related elements are valid, i. e. Revision or Configuration."@en ,
		"Umfasst Elemente, die einen Kontext repräsentieren, in welchem verknüpfte Elemente gültig sind, z. B. Revision oder Konfiguration."@de
		;
	.

cas-ctx:Change
	a owl:Class ;
	rdfs:subClassOf cas:Entity ;
	rdfs:label
		"Change"@en ,
		"Änderung"@de
		;
