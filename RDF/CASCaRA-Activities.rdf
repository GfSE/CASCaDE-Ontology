		<cas:uses rdf:resource="&fld;HydraulicPneumaticPort"/>
		<cas:uses rdf:resource="&mech;BendingSpecification"/>
		<cas:uses rdf:resource="&mech;Body"/>
		<cas:uses rdf:resource="&mech;Cleanliness"/>
		<cas:uses rdf:resource="&mech;Datum"/>
		<cas:uses rdf:resource="&mech;DimensionalSize"/>
		<cas:uses rdf:resource="&mech;Gearing"/>
		<cas:uses rdf:resource="&mech;GeometricTolerance"/>
		<cas:uses rdf:resource="&mech;HeatTreatedArea"/>
		<cas:uses rdf:resource="&mech;Hole"/>
		<cas:uses rdf:resource="&mech;JoiningElement"/>
		<cas:uses rdf:resource="&mech;KinematicJoint"/>
		<cas:uses rdf:resource="&mech;KinematicMechanism"/>
		<cas:uses rdf:resource="&mech;MarkingLabeling"/>
		<cas:uses rdf:resource="&mech;Material"/>
		<cas:uses rdf:resource="&mech;MechanicalComponent"/>
		<cas:uses rdf:resource="&mech;ModelView"/>
		<cas:uses rdf:resource="&mech;PaintedCoatedArea"/>
		<cas:uses rdf:resource="&mech;SurfaceTexture"/>
		<cas:uses rdf:resource="&mech;Thread"/>
		<skos:definition xml:lang="en">The task in the manufacturing process planning domain is to find a plan to manufacture a set of parts.
Source: https://www.cs.cmu.edu/afs/cs/project/jair/pub/volume15/ambite01a-html/node23.html</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="http://www.omg.org/spec/CASCaRA/ontology/DigitalDataPackage/CollaborationUseCases/ProductionDevelopment/ToolsEquipmentDesign">
